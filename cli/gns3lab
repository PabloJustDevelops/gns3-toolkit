def cmd_status(args, conf):
    s = Server(args.server, conf)
    if not s.alive():
        print(f"servidor {s.name} ({s.url}) no responde", file=sys.stderr)
        return 2
    projects = s.projects()
    try:
        target = s.resolve(args.project)
    except SystemExit:
        target = None
    for p in projects:
        opened = "abierto" if p.get("status") == "opened" else "cerrado"
        star = " *" if target and p["project_id"] == target["project_id"] else "  "
        print(f"{star} {p['name']:<32} {opened:<8} {p['project_id'][:8]}")
        if target and p["project_id"] == target["project_id"]:
            for n in s.nodes(p["project_id"]):
                st = n.get("status") or "-"
                cons = n.get("console_type") or "-"
                print(f"      {n['name']:<16} {n['node_type']:<16} {st:<9} {cons}:{n.get('console')}")
    return 0


def _set_state(s: Server, pid: str, ids: list[str], action: str) -> int:
    fails = 0
    for nid in ids:
        st, body = s.post(f"/v2/projects/{pid}/nodes/{nid}/{action}", timeout=180)
        if st not in (200, 201, 204):
            msg = body.get("message") if isinstance(body, dict) else body
            print(f"    fallo en {nid[:8]}: [{st}] {msg}")
            fails += 1
    return fails


def _wait_node_status(c, pid: str, nid: str, want: str, timeout: float = 45.0) -> str:
    """Relee el nodo hasta que la API confirme `want` (un 200 no prueba nada)."""
    end = time.time() + timeout
    last = None
    while True:
        st, detail = c.get(f"/v2/projects/{pid}/nodes/{nid}")
        if st == 200 and isinstance(detail, dict):
            last = detail.get("status")
            if last == want:
                return last
        if time.time() >= end:
            return last or "?"
        time.sleep(1.0)


def _json_out(obj) -> None:
    print(json.dumps(obj, ensure_ascii=False, indent=2, default=str))


def _core_call(fn, *a, **kw):
    """Llama al núcleo y convierte un corte de red en un error legible.

    El servidor puede reiniciarse a mitad de una consulta larga (`/v2/appliances`
    devuelve un JSON grande): sin esto sale un traceback de `ConnectionReset`.
    """
    try:
        return fn(*a, **kw)
    except BrokenPipeError:
        raise                     # stdout cerrado (| head): no es un fallo de red
    except (ConnectionError, TimeoutError) as e:
        raise SystemExit(f"fallo de conexión con el servidor: {e}")


COMPUTE_FIELDS = ("compute_id", "name", "connected", "protocol", "host", "port", "user",
                  "cpu_usage_percent", "memory_usage_percent", "last_error")


def _compute_row(comp: dict) -> dict:
    return {k: comp.get(k) for k in COMPUTE_FIELDS}


def cmd_compute(args, conf):
    """Compute(s): `compute` lista, `compute <id|nombre>` da el detalle."""
    s = Server(args.server, conf)
    c = _core_client(s)
    comps = _core_call(c.computes)
    if not comps:
        print(f"GET /v2/computes no devolvió computes en {s.url}", file=sys.stderr)
        return 1
    if not args.cid:
        filas = [_compute_row(x) for x in comps]
        if args.json:
            _json_out({"count": len(filas), "computes": filas})
            return 0
        for r in filas:
            estado = "conectado" if r["connected"] else "DESCONECTADO"
            print(f"  {str(r['compute_id']):<10} {str(r['name']):<24} {estado:<12} "
                  f"{r['protocol']}://{r['host']}:{r['port']}")
        return 0

    needle = args.cid.lower()
    hits = [x for x in comps
            if str(x.get("compute_id", "")).lower() == needle
            or str(x.get("name", "")).lower() == needle]
    if not hits:
        raise SystemExit(f"compute no encontrado: {args.cid!r}. Hay: "
                         + ", ".join(str(x.get("compute_id")) for x in comps))
    if len(hits) > 1:
        raise SystemExit(f"'{args.cid}' es ambiguo: "
                         + ", ".join(str(x.get("compute_id")) for x in hits))
    cid = hits[0]["compute_id"]
    comp = _core_call(c.compute, cid)
    if not isinstance(comp, dict):
        print(f"GET /v2/computes/{cid} no devolvió datos", file=sys.stderr)
        return 1
    if args.json:
        _json_out(comp)
        return 0
    row = _compute_row(comp)
    caps = comp.get("capabilities") or {}
    print(f"  {row['name']} ({row['compute_id']}) "
          f"{'conectado' if row['connected'] else 'DESCONECTADO'}")
    print(f"    {row['protocol']}://{row['host']}:{row['port']} user={row['user']}")
    print(f"    plataforma={caps.get('platform')} versión={caps.get('version')} "
          f"cpu={row['cpu_usage_percent']}% mem={row['memory_usage_percent']}%")
    if row["last_error"]:
        print(f"    último error: {row['last_error']}")
    return 0


def _gib(n) -> str:
    try:
        return f"{int(n) / 2**30:.1f} GB"
    except (TypeError, ValueError):
        return "-"


def cmd_stats(args, conf):
    """Estadísticas de CPU, memoria y disco de cada compute."""
    s = Server(args.server, conf)
    c = _core_client(s)
    rows = _core_call(c.statistics)
    if not rows:
        print("GET /v2/statistics no devolvió estadísticas", file=sys.stderr)
        return 1
    if args.json:
        _json_out({"count": len(rows), "computes": rows})
        return 0
    for r in rows:
        st = r.get("statistics") or {}
        print(f"  {r.get('compute_name')} ({r.get('compute_id')})")
        print(f"    cpu {st.get('cpu_usage_percent')}%  "
              f"mem {st.get('memory_usage_percent')}% "
              f"({_gib(st.get('memory_used'))}/{_gib(st.get('memory_total'))})  "
              f"disco {st.get('disk_usage_percent')}%")
        print(f"    carga {st.get('load_average_percent')}  "
              f"swap {st.get('swap_usage_percent')}% "
              f"({_gib(st.get('swap_used'))}/{_gib(st.get('swap_total'))})")
    return 0


