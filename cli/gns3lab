def _kv_value(texto: str):
    """Valor de un --set clave=valor: JSON si se puede (números, booleanos), si no texto."""
    try:
        return json.loads(texto)
    except json.JSONDecodeError:
        return texto


def _template_row(t: dict) -> dict:
    return {
        "name": t.get("name"),
        "template_type": t.get("template_type"),
        "template_id": t.get("template_id"),
        "compute_id": t.get("compute_id"),
        "console": t.get("console"),
        "console_type": t.get("console_type"),
    }


def cmd_template(args, conf):
    """Plantillas: list, create (--from-node o --type), update y delete.

    `console` no se puede fijar en un nodo (`PUT` lo ignora con un 200 mentiroso),
    pero sí en la plantilla: se crea y se fija con un `PUT` aparte, porque el POST
    de plantillas rechaza `console` y `properties` anidado con un 400 de schema.
    """
    s = Server(args.server, conf)
    c = _core_client(s)
    act = args.action

    if act == "list":
        st, body = s.get("/v2/templates")
        if st != 200 or not isinstance(body, list):
            print(f"GET /v2/templates -> [{st}] {_err(body)}", file=sys.stderr)
            return 1
        filas = [_template_row(t) for t in body]
        if args.json:
            print(json.dumps({"count": len(filas), "templates": filas},
                             ensure_ascii=False, indent=2))
            return 0
        for r in filas:
            cons = f"console={r['console']} ({r['console_type']})" if r.get("console") else ""
            print(f"  {(r['template_type'] or ''):<16} {(r['name'] or ''):<32} "
                  f"{(r['template_id'] or '')[:8]}  {(r['compute_id'] or '-'):<8} {cons}")
        return 0

    if act == "create":
        if not args.name:
            raise SystemExit("create exige --name")
        if bool(args.from_node) == bool(args.type):
            raise SystemExit("create exige --from-node O --type (uno de los dos)")
        body: dict = {"name": args.name, "compute_id": "local"}
        console_type = None
        if args.from_node:
            proj = s.resolve(args.project)
            nodes = s.nodes(proj["project_id"])
            needle = args.from_node.lower()
            hits = ([n for n in nodes if str(n.get("name", "")).lower() == needle]
                    or [n for n in nodes if needle in str(n.get("name", "")).lower()])
            if not hits:
                raise SystemExit(f"nodo no encontrado: {args.from_node!r}. Hay: "
                                 f"{', '.join(n['name'] for n in nodes)}")
            if len(hits) > 1:
                raise SystemExit(f"'{args.from_node}' es ambiguo: "
                                 f"{', '.join(n['name'] for n in hits)}")
            src = hits[0]
            body["template_type"] = src["node_type"]
            console_type = src.get("console_type")
            props = dict(src.get("properties") or {})
            print(f"origen: {proj['name']} / {src['name']} ({src['node_type']})")
        else:
            body["template_type"] = args.type
            props = {}
        for kv in args.set:
            if "=" not in kv:
                raise SystemExit(f"--set espera clave=valor, no {kv}")
            k, v = kv.split("=", 1)
            props[k] = _kv_value(v)
        # Los md5sum son del fichero del nodo, no de la plantilla, y el schema los
        # rechaza; `console` tampoco entra en el POST (va en el PUT de después).
        for k in [k for k in props if k.endswith("_md5sum")]:
            del props[k]
        props.pop("console", None)
        body.update(props)
        if console_type and console_type != "none":
            body["console_type"] = console_type

        st, tpl = s.post("/v2/templates", body)
        if st not in (200, 201) or not isinstance(tpl, dict):
            print(f"no se pudo crear: [{st}] {_err(tpl)}", file=sys.stderr)
            return 1
        tid = tpl["template_id"]

        if args.console is not None:
            st, res = s.put(f"/v2/templates/{tid}", {"console": args.console})
            if st not in (200, 201):
                print(f"creada {tid[:8]} pero sin console: [{st}] {_err(res)}", file=sys.stderr)
                return 1

        # Releer: el 200 del PUT no prueba nada.
        st, check = s.get(f"/v2/templates/{tid}")
        if st != 200 or not isinstance(check, dict):
            print(f"creada {tid[:8]}, pero no puedo releerla: [{st}] {_err(check)}",
                  file=sys.stderr)
            return 1
        cons = check.get("console")
        print(f"{check.get('name')} creada: {tid} tipo={check.get('template_type')} "
              f"compute={check.get('compute_id')}")
        if args.console is None:
            print(f"  console={cons} ({check.get('console_type')})")
            return 0
        ok = cons == args.console
        print(f"  console={cons} ({check.get('console_type')}) "
              f"{'verificado' if ok else f'NO es el pedido ({args.console})'}")
        return 0 if ok else 1

    if act == "update":
        if not args.target:
            raise SystemExit("update exige el nombre o id de la plantilla")
        body = _set_body(args.set)
        if not body:
            raise SystemExit("update exige --set clave=valor (repetible)")
        st, tpls = c.get("/v2/templates")
        if st != 200 or not isinstance(tpls, list):
            print(f"GET /v2/templates -> [{st}] {_err(tpls)}", file=sys.stderr)
            return 1
        t = _resolve_id(tpls, args.target, "template_id", "plantilla")
        tid = t["template_id"]
        st, res = c.template_update(tid, body)
        if st not in (200, 201):
            print(f"no se pudo editar {t.get('name')}: [{st}] {_err(res)}", file=sys.stderr)
            return 1
        # El 200 del PUT no prueba nada: se relee y se comparan los campos pedidos.
        st, check = c.template_get(tid)
        if st != 200 or not isinstance(check, dict):
            print(f"editada {str(tid)[:8]}, pero no puedo releerla: [{st}] {_err(check)}",
                  file=sys.stderr)
            return 1
        cambios = ", ".join(f"{k}={check.get(k)!r}" for k in body)
        print(f"{check.get('name')} ({str(tid)[:8]}) editada: {cambios}")
        malos = {k: {"pedido": v, "leído": check.get(k)}
                 for k, v in body.items() if check.get(k) != v}
        if malos:
            print(f"  la API no aplicó: {malos}", file=sys.stderr)
            return 1
        return 0

    if act == "delete":
        if not args.target:
            raise SystemExit("delete exige el nombre o id de la plantilla")
        if not args.yes:
            if not sys.stdin.isatty():
                print("borrar una plantilla es irreversible y stdin no es un TTY: "
                      "repite con --yes", file=sys.stderr)
                return 1
            if input(f"¿borrar la plantilla {args.target!r}? [y/N] ").strip().lower() \
                    not in ("y", "s", "si", "sí", "yes"):
                print("cancelado")
                return 1
        st, body = s.get("/v2/templates")
        if st != 200 or not isinstance(body, list):
            print(f"GET /v2/templates -> [{st}] {_err(body)}", file=sys.stderr)
            return 1
        needle = args.target
        hits = ([t for t in body if str(t.get("template_id", "")) == needle]
                or [t for t in body if str(t.get("template_id", "")).startswith(needle)]
                or [t for t in body if str(t.get("name", "")).lower() == needle.lower()])
        if not hits:
            raise SystemExit(f"ninguna plantilla coincide con '{needle}'")
        if len(hits) > 1:
            raise SystemExit(f"'{needle}' es ambiguo: "
                             + ", ".join(f"{t.get('name')} ({str(t.get('template_id'))[:8]})"
                                         for t in hits))
        t = hits[0]
        st, res = c.template_delete(t["template_id"])
        if st not in (200, 204):
            print(f"no se pudo borrar: [{st}] {_err(res)}", file=sys.stderr)
            return 1
        print(f"borrada {t.get('name')} ({t.get('template_type')}, "
              f"{str(t['template_id'])[:8]})")
        return 0

    raise SystemExit(f"acción desconocida: {act}")


def cmd_snap(args, conf):
    """Snapshots del proyecto: list, create, restore y delete."""
    s = Server(args.server, conf)
    c = _core_client(s)
    proj = c.resolve_project(args.project)
    pid = proj["project_id"]
    if args.action == "list":
        snaps = c.snapshots(pid)
        if not snaps:
            print("  sin snapshots")
            return 0
        for snap in snaps:
            print(f"  {snap.get('name')}  ({str(snap.get('snapshot_id'))[:8]})")
        return 0
    if args.action == "create":
        if not args.name:
            raise SystemExit("falta el nombre del snapshot")
        # El snapshot exporta el proyecto entero: GNS3 lo exige parado. Paramos,
        # creamos y volvemos a arrancar lo que estaba arrancado.
        nodos = s.nodes(pid)
        estaban = [n["node_id"] for n in nodos if n.get("status") == "started"]
        if estaban:
            print(f"  parando {len(estaban)} nodo(s) para poder congelar")
            _set_state(s, pid, estaban, "stop")
            time.sleep(2)
        st, body = c.snapshot_create(pid, args.name)
        print(f"  crear '{args.name}' -> [{st}]"
              + ("" if st in (200, 201) else f" {_err(body)}"))
        if estaban:
            print(f"  arrancando de nuevo {len(estaban)} nodo(s)")
            _set_state(s, pid, estaban, "start")
        return 0 if st in (200, 201) else 1
    if args.action in ("restore", "delete"):
        if not args.name:
            raise SystemExit(f"falta el nombre del snapshot para {args.action}")
        snaps = c.snapshots(pid)
        if not snaps:
            nombre = proj.get("name")
            raise SystemExit(f"'{nombre}' no tiene snapshots")
        snap = _resolve_id(snaps, args.name, "snapshot_id", "snapshot")
        sid = str(snap["snapshot_id"])
        if args.action == "delete":
            st, body = c.snapshot_delete(pid, sid)
            if st not in (200, 204):
                print(f"no se pudo borrar '{args.name}': [{st}] {_err(body)}", file=sys.stderr)
                return 1
            nombre_snap = snap.get("name")
            print(f"  borrado '{nombre_snap}' ({sid[:8]}); "
                  f"quedan {len(c.snapshots(pid))}")
            return 0
        nodos = s.nodes(pid)
        estaban = [n["node_id"] for n in nodos if n.get("status") == "started"]
        if estaban:
            print(f"  parando {len(estaban)} nodo(s) para restaurar")
            _set_state(s, pid, estaban, "stop")
            time.sleep(2)
        st, body = c.snapshot_restore(pid, sid)
        nombre_snap = snap.get("name")
        print(f"  restaurar '{nombre_snap}' -> [{st}]"
              + ("" if st in (200, 201) else f" {_err(body)}"))
        if estaban:
            print(f"  arrancando {len(estaban)} nodo(s)")
            _set_state(s, pid, estaban, "start")
        return 0 if st in (200, 201) else 1
    return 1


# --------------------------------------------------------------------------- #
# consola: ejecutar, teclear y leer la pantalla sin VNC (núcleo gns3core)
# --------------------------------------------------------------------------- #
def _core_client(s: Server) -> "core.Client":
    return core.Client(s.url, s.auth, s.matcher, s.name)


def _core_project(s: Server, project: str | None):
    c = _core_client(s)
    proj = c.resolve_project(project)
    c.ensure_open(proj["project_id"])
    return c, proj


def _core_target(s: Server, project: str | None, node: str | None):
    c, proj = _core_project(s, project)
    if node is None:
        raise SystemExit("falta el nombre del nodo")
    obj = c.find_node(proj["project_id"], node)
    return c, proj, obj


def cmd_exec(args, conf):
    """Ejecuta comandos en la consola telnet: lectura por prompt, no por sleep."""
    s = Server(args.server, conf)
    c, proj, node = _core_target(s, args.project, args.node)
    if node.get("status") != "started":
        print(f"{node['name']} no está arrancado (status={node.get('status')})", file=sys.stderr)
        return 1
    try:
        con = core.console_for(c, proj["project_id"], node)
    except core.ConsoleError as e:
        print(str(e), file=sys.stderr)
        return 1
    try:
        ready = con.wait_ready(timeout=args.ready_timeout)
        print(f"{proj['name']} / {node['name']}  prompt={ready.get('prompt')!r} "
              f"ready={ready.get('ready')}", file=sys.stderr)
        fails = 0
        for r in con.run_many(args.commands, expect=args.expect, idle=args.idle,
                              timeout=args.timeout, answers=args.answers):
            print(f"$ {r['cmd']}")
            if r["output"]:
                print(r["output"])
            if r["timed_out"]:
                print(f"  [timeout tras {r['ms']} ms — la salida no se estabilizó]", file=sys.stderr)
                fails += 1
            print()
        return 1 if fails else 0
    finally:
        con.close()


def cmd_console(args, conf):
    """Consola única del nodo: interactiva por stdin o `--send` sin TTY.

    Es el atajo contra el VNC: una sola sesión telnet con prompt real, en vez de
    abrir y cerrar el socket en cada comando. `exit` (o Ctrl-D) sale sin mandar nada
    al nodo. En un nodo gráfico se remite a `shot`/`type`/`key`, igual que `exec`.
    """
    s = Server(args.server, conf)
    c, proj, node = _core_target(s, args.project, args.node)
    if node.get("status") != "started":
        print(f"{node['name']} no está arrancado (status={node.get('status')})", file=sys.stderr)
        return 1
    try:
        con = core.console_for(c, proj["project_id"], node)
    except core.ConsoleError as e:
        print(str(e), file=sys.stderr)
        print("  consola gráfica: usa `gns3lab shot`, `gns3lab type` o `gns3lab key` "
              "(el VNC es el último recurso)", file=sys.stderr)
        return 1
    try:
        ready = con.wait_ready(timeout=args.ready_timeout)
        print(f"{proj['name']} / {node['name']}  prompt={ready.get('prompt')!r} "
              f"ready={ready.get('ready')}", file=sys.stderr)
        if args.send:
            fails = 0
            for cmd in args.send:
                r = con.run(cmd, expect=args.expect, idle=args.idle, timeout=args.timeout)
                if r["output"]:
                    print(r["output"])
                if r["timed_out"]:
                    print(f"  [timeout tras {r['ms']} ms — la salida no se estabilizó]",
                          file=sys.stderr)
                    fails += 1
            return 1 if fails else 0

        if sys.stdin.isatty():
            print("escribe comandos; `exit` para salir", file=sys.stderr)
        while True:
            sys.stderr.write(f"{node['name']}> ")
            sys.stderr.flush()
            linea = sys.stdin.readline()
            if not linea:                    # EOF: tubería cerrada o Ctrl-D
                sys.stderr.write("\n")
                break
            linea = linea.rstrip("\r\n")
            if linea.strip().lower() in ("exit", "quit", "salir"):
                break
            if not linea.strip():
                continue
            try:
                r = con.run(linea, expect=args.expect, idle=args.idle, timeout=args.timeout)
            except core.ConsoleError as e:
                print(f"consola cerrada: {e}", file=sys.stderr)
                return 1
            if r["output"]:
                print(r["output"])
            if r["timed_out"]:
                print(f"  [timeout tras {r['ms']} ms]", file=sys.stderr)
        return 0
    except KeyboardInterrupt:
        print("\nsalgo", file=sys.stderr)
        return 130
    finally:
        con.close()


def _monitor(s: Server, project, node_name) -> "core.QemuMonitor":
    c, proj, node = _core_target(s, project, node_name)
    if node.get("node_type") != "qemu":
        raise SystemExit(f"{node['name']} no es QEMU ({node.get('node_type')}); usa `gns3lab exec`")
    disk = (node.get("properties") or {}).get("hda_disk_image")
    try:
        return core.QemuMonitor.for_node(node_id=node["node_id"], disk=disk)
    except RuntimeError as e:
        raise SystemExit(str(e))


def cmd_shot(args, conf):
    """Captura el framebuffer del nodo y lo pasa por OCR: leer sin VNC."""
    s = Server(args.server, conf)
