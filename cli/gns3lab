def cmd_doctor(args, conf):
    """Chequeo integral antes de dar un lab por bueno."""
    s = Server(args.server, conf)
    problemas: list[str] = []
    lineas: list[str] = []
    report: dict = {"server": {"name": s.name, "url": s.url}, "problems": problemas}

    def say(texto: str = "") -> None:
        lineas.append(texto)

    say(f"servidor {s.name} ({s.url})")
    if not s.alive():
        if args.json:
            report.update({"alive": False, "ok": False})
            print(json.dumps(report, ensure_ascii=False, indent=2))
        else:
            print("  NO responde: arráncalo (gns3server) antes de nada", file=sys.stderr)
        return 2
    report["alive"] = True
    st, ver = s.get("/v2/version")
    version = ver.get("version") if isinstance(ver, dict) else "?"
    report["version"] = version
    say(f"  versión {version}")
    st, computes = s.get("/v2/computes")
    computes = computes if isinstance(computes, list) else []
    report["computes"] = [{"name": c.get("name"), "connected": bool(c.get("connected"))}
                          for c in computes]
    for comp in computes:
        ok = comp.get("connected")
        say(f"  compute {comp.get('name')}: {'conectado' if ok else 'DESCONECTADO'}")
        if not ok:
            problemas.append(f"compute {comp.get('name')} desconectado")
    herramientas: dict[str, bool] = {}
    for b in ("tesseract", "qemu-img", "tshark", "sshpass"):
        presente = bool(shutil.which(b))
        herramientas[b] = presente
        say(f"  {b:<10} {'OK' if presente else 'falta'}")
        if b == "tesseract" and not presente:
            problemas.append("sin tesseract: `gns3lab shot` no puede dar texto")
    report["tools"] = herramientas
    lv = subprocess.run(["systemctl", "is-active", "libvirtd"],
                        capture_output=True, text=True).stdout.strip()
    report["libvirtd"] = lv or None
    say(f"  libvirtd   {lv or 'desconocido'}")
    if lv != "active":
        problemas.append("libvirtd parado: los nodos NAT no arrancan "
                         "(`sudo systemctl start libvirtd`)")
    try:
        import PIL  # noqa: F401
        report["pillow"] = True
        say("  Pillow     OK")
    except ImportError:
        report["pillow"] = False
        problemas.append("sin Pillow: el screendump queda en PPM")

    projs = s.projects()
    try:
        target = s.resolve(args.project)
    except SystemExit:
        target = None
    if not target:
        report["projects"] = {"count": len(projs), "selected": None}
        say(f"  {len(projs)} proyectos, ninguno seleccionable")
        report["nodes"] = []
        report["ok"] = False
        _emit_doctor(report, lineas, args.json)
        return 1
    say(f"  proyecto {target['name']} ({target['project_id'][:8]}, {target.get('status')})")
    report["projects"] = {"count": len(projs), "selected": target["name"],
                          "project_id": target["project_id"],
                          "status": target.get("status")}
    if target.get("status") != "opened":
        say("    aviso: cerrado; `gns3lab up` lo abre")
    nodes = s.nodes(target["project_id"])
    discos: dict[str, list[str]] = {}
    report["nodes"] = []
    for n in nodes:
        props = n.get("properties") or {}
        hda = props.get("hda_disk_image") or ""
        cons = n.get("console")
        say(f"    {n['name']:<18} {n['node_type']:<16} {(n.get('status') or '-'):<9} "
            f"console={cons} ({n.get('console_type')})")
        report["nodes"].append({"name": n["name"], "node_type": n["node_type"],
                                "status": n.get("status"), "console": cons,
                                "console_type": n.get("console_type"),
                                "hda_disk_image": hda or None})
        if hda:
            discos.setdefault(hda, []).append(n["name"])
        if n.get("status") != "started":
            problemas.append(f"{n['name']} no está arrancado")
        if n["node_type"] == "qemu" and n.get("status") == "started":
            mon = core.find_monitor_port(n["node_id"], hda)
            if not mon:
                problemas.append(f"{n['name']}: sin monitor HMP visible (¿proceso de otro usuario?)")
    imgs = s.qemu_images()          # Server.qemu_images() devuelve nombres
    for img, quienes in discos.items():
        if len(quienes) > 1:
            problemas.append(f"disco compartido {img} entre {quienes}: un cambio de config afecta a los dos")
        if img not in imgs:
            problemas.append(f"imagen ausente en el servidor: {img}")
    nat = any(n["node_type"] == "nat" for n in nodes)
    if not nat:
        problemas.append("sin nodo NAT: la WAN se quedará sin IP (usa `gns3lab node add --template NAT`)")
    say("")
    say("  resumen")
    if problemas:
        for p in problemas:
            say(f"    - {p}")
        report["ok"] = False
        _emit_doctor(report, lineas, args.json)
        return 1
    say("    sin hallazgos")
    report["ok"] = True
    _emit_doctor(report, lineas, args.json)
    return 0


