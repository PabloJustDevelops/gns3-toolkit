def cmd_snap(args, conf):
    s = Server(args.server, conf)
    proj = s.resolve(args.project)
    pid = proj["project_id"]
    if args.action == "list":
        st, body = s.get(f"/v2/projects/{pid}/snapshots")
        if st != 200 or not body:
            print("  sin snapshots")
            return 0
        for snap in body:
            print(f"  {snap.get('name')}")
        return 0
    if args.action == "create":
        if not args.name:
            raise SystemExit("falta el nombre del snapshot")
        # El snapshot exporta el proyecto entero: GNS3 lo exige parado. Paramos,
        # creamos y volvemos a arrancar lo que estaba arrancado.
        nodos = s.nodes(pid)
        estaban = [n["node_id"] for n in nodos if n.get("status") == "started"]
        if estaban:
            print(f"  parando {len(estaban)} nodo(s) para poder congelar")
            _set_state(s, pid, estaban, "stop")
            time.sleep(2)
        st, body = s.post(f"/v2/projects/{pid}/snapshots", {"name": args.name})
        msg = body.get("message") if isinstance(body, dict) else body
        print(f"  crear '{args.name}' -> [{st}]" + (f" {msg}" if st not in (200, 201) else ""))
        if estaban:
            print(f"  arrancando de nuevo {len(estaban)} nodo(s)")
            _set_state(s, pid, estaban, "start")
        return 0 if st in (200, 201) else 1
    if args.action == "restore":
        if not args.name:
            raise SystemExit("falta el nombre del snapshot")
        nodos = s.nodes(pid)
        estaban = [n["node_id"] for n in nodos if n.get("status") == "started"]
        if estaban:
            print(f"  parando {len(estaban)} nodo(s) para restaurar")
            _set_state(s, pid, estaban, "stop")
            time.sleep(2)
        st, body = s.post(f"/v2/projects/{pid}/snapshots/{args.name}/restore", {}, timeout=300)
        msg = body.get("message") if isinstance(body, dict) else body
        print(f"  restaurar '{args.name}' -> [{st}]" + (f" {msg}" if st not in (200, 201) else ""))
        if estaban:
            print(f"  arrancando {len(estaban)} nodo(s)")
            _set_state(s, pid, estaban, "start")
        return 0 if st in (200, 201) else 1
    return 1


