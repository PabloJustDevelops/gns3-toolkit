def _ws_open(url: str, auth, timeout: float):
    """Handshake WebSocket por stdlib; devuelve (socket, bytes leídos de más)."""
    u = urllib.parse.urlsplit(url)
    if u.scheme not in ("ws", "wss"):
        raise ValueError(f"esquema WebSocket no soportado: {u.scheme!r}")
    host = u.hostname or "127.0.0.1"
    port = u.port or (443 if u.scheme == "wss" else 80)
    sock = socket.create_connection((host, port), timeout=timeout)
    try:
        if u.scheme == "wss":
            sock = ssl.create_default_context().wrap_socket(sock, server_hostname=host)
        key = base64.b64encode(os.urandom(16)).decode()
        path = u.path or "/"
        if u.query:
            path += "?" + u.query
        lineas = [f"GET {path} HTTP/1.1", f"Host: {host}:{port}",
                  "Upgrade: websocket", "Connection: Upgrade",
                  f"Sec-WebSocket-Key: {key}", "Sec-WebSocket-Version: 13"]
        if auth:
            tok = base64.b64encode(f"{auth[0]}:{auth[1]}".encode()).decode()
            lineas.append(f"Authorization: Basic {tok}")
        sock.sendall(("\r\n".join(lineas) + "\r\n\r\n").encode())
        buf = b""
        while b"\r\n\r\n" not in buf:
            chunk = sock.recv(4096)
            if not chunk:
                raise ConnectionError("el servidor cerró durante el handshake WebSocket")
            buf += chunk
            if len(buf) > 65536:
                raise ValueError("cabecera WebSocket demasiado larga")
        head, rest = buf.split(b"\r\n\r\n", 1)
        status = head.split(b"\r\n", 1)[0].decode(errors="replace")
        if " 101" not in status:
            raise ConnectionError(f"handshake WebSocket rechazado: {status}")
        return sock, rest
    except BaseException:
        sock.close()
        raise


def _ws_frame(sock, pending: bytes):
    """Lee un frame WS: (texto, pendientes); None como texto = frame de cierre."""
    def take(n: int) -> bytes:
        nonlocal pending
        while len(pending) < n:
            chunk = sock.recv(65536)
            if not chunk:
                raise ConnectionError("el servidor cerró el canal WebSocket")
            pending += chunk
        out, pending = pending[:n], pending[n:]
        return out

    b0, b1 = take(2)
    opcode = b0 & 0x0F
    masked = bool(b1 & 0x80)
    length = b1 & 0x7F
    if length == 126:
        length = struct.unpack("!H", take(2))[0]
    elif length == 127:
        length = struct.unpack("!Q", take(8))[0]
    mask = take(4) if masked else None
    payload = take(length)
    if mask:
        payload = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
    if opcode == 0x8:
        return None, pending
    if opcode == 0x9:            # ping: se responde con pong enmascarado
        sock.sendall(b"\x8a\x80" + os.urandom(4))
        return "", pending
    if opcode != 0x1:            # binario/continuación: no son eventos JSON
        return "", pending
    return payload.decode(errors="replace"), pending


def cmd_watch(args, conf):
    """Eventos en vivo por WebSocket (stdlib), con salida por timeout."""
    s = Server(args.server, conf)
    c = _core_client(s)
    pid = None
    if args.project:
        # watch es pasivo: resolver el proyecto no debe abrirlo.
        pid = c.resolve_project(args.project)["project_id"]
    url = c.notifications_ws_url(pid)
    print(f"WebSocket: {url}", file=sys.stderr)
    deadline = time.monotonic() + args.seconds
    try:
        sock, pending = _ws_open(url, s.auth, timeout=max(0.1, min(args.seconds, 5.0)))
    except (OSError, ValueError) as e:
        print(f"no conecta: {type(e).__name__}: {e}", file=sys.stderr)
        print(f"URL: {url}", file=sys.stderr)
        return 1
    eventos = 0
    try:
        while time.monotonic() < deadline:
            sock.settimeout(max(0.05, deadline - time.monotonic()))
            try:
                texto, pending = _ws_frame(sock, pending)
            except socket.timeout:
                break
            except (OSError, ValueError) as e:
                print(f"error WS: {type(e).__name__}: {e}", file=sys.stderr)
                return 1
            if texto is None:
                print("servidor cerró el canal WebSocket", file=sys.stderr)
                break
            if not texto:
                continue
            try:
                evento = json.loads(texto)
            except json.JSONDecodeError:
                evento = texto
            if args.json:
                _json_out(evento)
            elif isinstance(evento, dict):
                print(f"  {str(evento.get('action', '?')):<28} "
                      f"{json.dumps(evento.get('event', {}), ensure_ascii=False)[:200]}")
            else:
                print(f"  {evento}")
            eventos += 1
        print(f"{eventos} evento(s) en {args.seconds:g} s")
    finally:
        sock.close()
    return 0


