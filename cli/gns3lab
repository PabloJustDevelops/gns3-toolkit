def load_conf() -> dict:
    if CONF.exists():
        try:
            return json.loads(CONF.read_text())
        except json.JSONDecodeError:
            print(f"aviso: {CONF} no es JSON válido, uso los valores por defecto", file=sys.stderr)
    return json.loads(json.dumps(DEFAULT_CONF))


def gns3_local_auth() -> tuple[str, str] | None:
    """Credenciales del servidor local, leídas del conf de la GUI."""
    if not GNS3_CONF.exists():
        return None
    txt = GNS3_CONF.read_text()
    user = re.search(r"^user\s*=\s*(\S+)", txt, re.M)
    pwd = re.search(r"^password\s*=\s*(\S+)", txt, re.M)
    if user and pwd:
        return user.group(1), pwd.group(1)
    return None


class Server:
    def __init__(self, name: str, conf: dict):
        servers = conf.get("servers", {})
        if name not in servers:
            raise SystemExit(
                f"servidor '{name}' no configurado. Disponibles: {', '.join(servers)}"
            )
        self.name = name
        self.url = servers[name]["url"].rstrip("/")
        auth = servers[name].get("auth")
        self.auth = gns3_local_auth() if auth == "from-gns3-conf" else None
        # p. ej. "Pablo Rodriguez" para no tocar el proyecto de un compañero
        self.matcher = servers[name].get("matcher")

    # -- transporte ------------------------------------------------------- #
    def _req(self, method: str, path: str, data: bytes | None = None,
             ctype: str = "application/json", timeout: int = 60, raw: bool = False):
        url = self.url + path
        headers = {}
        if data is not None:
            headers["Content-Type"] = ctype
        if self.auth:
            tok = base64.b64encode(f"{self.auth[0]}:{self.auth[1]}".encode()).decode()
            headers["Authorization"] = "Basic " + tok
        req = urllib.request.Request(url, data=data, headers=headers, method=method)
        try:
            with urllib.request.urlopen(req, timeout=timeout) as r:
                body = r.read()
                return r.status, (body if raw else self._json(body))
        except urllib.error.HTTPError as e:
            body = e.read()
            return e.code, (body if raw else self._json(body))
        except urllib.error.URLError as e:
            raise SystemExit(f"no puedo conectar con {self.url}: {e.reason}")

    @staticmethod
    def _json(body: bytes):
        if not body:
            return None
        try:
            return json.loads(body.decode())
        except (json.JSONDecodeError, UnicodeDecodeError):
            return body.decode(errors="replace")

    def get(self, path: str, **kw):
        return self._req("GET", path, **kw)

    def post(self, path: str, payload=None, **kw):
        data = json.dumps(payload).encode() if payload is not None else b""
        return self._req("POST", path, data=data, **kw)

    def put(self, path: str, payload: dict):
        return self._req("PUT", path, data=json.dumps(payload).encode())

    def delete(self, path: str):
        return self._req("DELETE", path)

    # -- consultas -------------------------------------------------------- #
    def alive(self) -> bool:
        try:
            st, body = self.get("/v2/version", timeout=6)
            return st == 200 and isinstance(body, dict)
        except SystemExit:
            return False

    def projects(self) -> list[dict]:
        st, body = self.get("/v2/projects")
        if st != 200 or not isinstance(body, list):
            raise SystemExit(f"GET /v2/projects -> {st}: {body}")
        return body

    def nodes(self, pid: str) -> list[dict]:
        st, body = self.get(f"/v2/projects/{pid}/nodes")
        if st != 200 or not isinstance(body, list):
            raise SystemExit(f"nodos de {pid} -> {st}: {body}")
        return body

    def links(self, pid: str) -> list[dict]:
        st, body = self.get(f"/v2/projects/{pid}/links")
        return body if st == 200 and isinstance(body, list) else []

    def qemu_images(self) -> list[str]:
        st, body = self.get("/v2/computes/local/qemu/images")
        if st != 200 or not isinstance(body, list):
            return []
        return [i.get("filename", "") for i in body]

    def resolve(self, needle: str | None) -> dict:
        """Encuentra un proyecto por nombre parcial o id."""
        projects = self.projects()
        if not projects:
            raise SystemExit("el servidor no tiene proyectos")
        if needle:
            low = needle.lower()
            hits = [p for p in projects
                    if low in p["name"].lower() or p["project_id"].startswith(needle)]
            if not hits:
                raise SystemExit(f"ningún proyecto coincide con '{needle}'")
            if len(hits) > 1:
                nombres = ", ".join(f"{p['name']} ({p['project_id'][:8]})" for p in hits)
                raise SystemExit(f"'{needle}' es ambiguo: {nombres}")
            return hits[0]
        opened = [p for p in projects if p.get("status") == "opened"]
        if len(opened) == 1:
            return opened[0]
        if len(opened) > 1:
            # En un servidor de aula hay varios abiertos (los de los compañeros). Si
            # el servidor tiene un `matcher` en la config y casa con uno solo, es el
            # nuestro; si no, hay que decir cuál.
            if self.matcher:
                hits = [p for p in opened if re.search(self.matcher, p["name"], re.I)]
                if len(hits) == 1:
                    return hits[0]
            nombres = ", ".join(f"{p['name']} ({p['project_id'][:8]})" for p in opened)
            raise SystemExit(f"hay varios abiertos, di cuál: {nombres}")
        if len(projects) == 1:
            return projects[0]
        nombres = ", ".join(f"{p['name']} ({p['project_id'][:8]})" for p in projects)
        raise SystemExit(f"ninguno abierto; di cuál: {nombres}")


