def cmd_capture(args, conf):
    """Captura de un enlace: start, stop y descarga del pcap.

    Sólo arranca o para la captura que se le pide; no toca nada más del proyecto.
    """
    s = Server(args.server, conf)
    c, proj = _core_project(s, args.project)
    pid = proj["project_id"]
    enlace = _resolve_id(c.links(pid), args.link, "link_id", "enlace")
    lid = enlace["link_id"]
    act = args.action

    if act == "start":
        st, res = c.link_capture(pid, lid, "start")
        if st not in (200, 201):
            print(f"no se pudo iniciar la captura de {lid[:8]}: [{st}] {_err(res)}",
                  file=sys.stderr)
            return 1
        st2, check = c.get(f"/v2/projects/{pid}/links/{lid}")
        estado = check.get("capturing") if isinstance(check, dict) else None
        nombre = check.get("capture_file_name") if isinstance(check, dict) else None
        print(f"captura iniciada en {lid[:8]} -> capturing={estado} "
              f"({nombre or 'sin nombre'})")
        print(f"  párala con `gns3lab capture {lid[:8]} stop`")
        return 0

    if act == "stop":
        st, res = c.link_capture(pid, lid, "stop")
        ok = st in (200, 201, 204)
        if not ok:
            print(f"no se pudo parar la captura de {lid[:8]}: [{st}] {_err(res)}",
                  file=sys.stderr)
            return 1
        st2, check = c.get(f"/v2/projects/{pid}/links/{lid}")
        estado = check.get("capturing") if isinstance(check, dict) else None
        print(f"captura parada en {lid[:8]} -> capturing={estado}")
        return 0

    if act == "pcap":
        st = 0
        data = None
        # GET .../pcap no termina mientras la captura está activa: espera 180 s y
        # acaba en TimeoutError. GNS3 ya escribe el fichero en el proyecto.
        st_link, link = c.get(f"/v2/projects/{pid}/links/{lid}")
        activa = st_link == 200 and isinstance(link, dict) and bool(link.get("capturing"))
        detalle = "captura activa: GET .../pcap no devuelve hasta pararla" if activa else ""
        if not activa:
            try:
                st, data = c.link_capture(pid, lid, "pcap")
            except (TimeoutError, ConnectionError) as e:
                detalle = str(e)
            if st != 200 or not isinstance(data, bytes) or not data:
                detalle = (data.decode(errors="replace")[:200]
                           if isinstance(data, bytes) else str(data))
                data = None
        if data is None:
            # Con la captura parada la API puede dar 409: el fichero queda en el proyecto.
            proyecto = c.project_get(pid)
            base = Path(proyecto.get("path") or "") if isinstance(proyecto, dict) else None
            cands = sorted((base / "project-files" / "captures").glob("*.pcap"),
                           key=lambda p: p.stat().st_mtime, reverse=True) \
                if base and base.is_dir() else []
            if not cands:
                print(f"no pude descargar el pcap de {lid[:8]}: [{st or '-'}] {detalle}",
                      file=sys.stderr)
                return 1
            propios = [p for p in cands if lid[:8] in p.name]
            fichero = (propios or cands)[0]
            data = fichero.read_bytes()
            aviso = f"GET .../pcap -> [{st}] {detalle}" if st else detalle
            print(f"  aviso: {aviso}; uso {fichero.name}", file=sys.stderr)
        destino_dir = Path.home() / "GNS3/captures"
        destino_dir.mkdir(parents=True, exist_ok=True)
        destino = destino_dir / f"cap-{time.strftime('%Y%m%d-%H%M%S')}-{lid[:8]}.pcap"
        destino.write_bytes(data)
        print(f"{destino}  ({len(data)/1024:.1f} KB)")
        return 0

    raise SystemExit(f"acción de captura desconocida: {act}")


