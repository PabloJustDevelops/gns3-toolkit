def _set_body(kvs: list[str]) -> dict:
    """Convierte `--set clave=valor` repetidos en un dict (valores JSON si se puede)."""
    body: dict = {}
    for kv in kvs or []:
        if "=" not in kv:
            raise SystemExit(f"--set espera clave=valor, no {kv}")
        k, v = kv.split("=", 1)
        body[k] = _kv_value(v)
    return body


def _resolve_id(items: list[dict], needle: str, key: str, what: str) -> dict:
    """Busca un objeto por id exacto, prefijo de id o nombre exacto."""
    exact = [x for x in items if str(x.get(key, "")) == needle]
    if exact:
        return exact[0]
    pref = [x for x in items if str(x.get(key, "")).startswith(needle)]
    if len(pref) == 1:
        return pref[0]
    named = [x for x in items if str(x.get("name", "")).lower() == needle.lower()]
    hits = pref or named
    if not hits:
        raise SystemExit(f"{what} no encontrado: {needle!r}")
    if len(hits) > 1:
        raise SystemExit(f"'{needle}' es ambiguo: "
                         + ", ".join(f"{x.get('name') or str(x.get(key))[:8]}"
                                     for x in hits))
    return hits[0]


def cmd_up(args, conf):
    s = Server(args.server, conf)
    proj = s.resolve(args.project)
    pid = proj["project_id"]
    if proj.get("status") != "opened":
        st, body = s.post(f"/v2/projects/{pid}/open", timeout=180)
        if st not in (200, 201):
            msg = body.get("message") if isinstance(body, dict) else body
            print(f"no abre: [{st}] {msg}", file=sys.stderr)
            return 1
    nodes = s.nodes(pid)
    pend = [n["node_id"] for n in nodes if n.get("status") != "started"]
    print(f"{proj['name']}: {len(nodes)} nodos, arranco {len(pend)}")
    fails = _set_state(s, pid, pend, "start")
    time.sleep(3)
    for n in s.nodes(pid):
        print(f"    {n['name']:<16} {n.get('status')}")
    return 1 if fails else 0


def cmd_down(args, conf):
    s = Server(args.server, conf)
    proj = s.resolve(args.project)
    pid = proj["project_id"]
    nodes = s.nodes(pid)
    started = [n["node_id"] for n in nodes if n.get("status") == "started"]
    fails = _set_state(s, pid, started, "stop")
    if not args.keep_open:
        s.post(f"/v2/projects/{pid}/close", timeout=180)
        print(f"{proj['name']}: parado y cerrado")
    else:
        print(f"{proj['name']}: parado ({len(started)} nodos), proyecto sigue abierto")
    return 1 if fails else 0


def cmd_test(args, conf):
    s = Server(args.server, conf)
    proj = s.resolve(args.project)
    pid = proj["project_id"]
    nodes = s.nodes(pid)
    vpcs = [n for n in nodes if n["node_type"] == "vpcs"]
    if not vpcs:
        print("no hay nodos VPCS en este proyecto")
        return 1
    host = urllib.parse.urlsplit(s.url).hostname or "127.0.0.1"
    con: dict[str, Vpcs] = {}
    info: dict[str, dict] = {}
    try:
        for n in vpcs:
            try:
                port = int(n.get("console") or 0)
                if not port:
                    print(f"  {n['name']}: sin puerto de consola")
                    continue
                c = Vpcs(host, port)
                out = c.run("show ip", settle=2.5)
                # Al arrancar, el VPCS puede no haber pedido lease todavía; se
                # insiste un par de veces antes de darlo por perdido.
                for _ in range(3):
                    if vpcs_ip(out) and not vpcs_ip(out).startswith("0.0.0.0"):
                        break
                    out = c.run("ip dhcp", "show ip", settle=4)
                    if vpcs_ip(out) and not vpcs_ip(out).startswith("0.0.0.0"):
                        break
                    time.sleep(2)
                con[n["name"]] = c
                info[n["name"]] = {"ip": vpcs_ip(out), "gw": vpcs_gateway(out)}
                print(f"  {n['name']:<12} ip={info[n['name']]['ip'] or '-':<16} gw={info[n['name']]['gw'] or '-'}")
            except OSError as e:
                print(f"  {n['name']}: consola {port} inalcanzable ({e})")
        if not con:
            return 1

        # El cliente VPCS a veces toma la máscara como gateway tras `ip dhcp` y todo
        # destino externo da "host not reachable". Se detecta por la propia gateway
        # (una .0 final en un /24 casi siempre es la máscara) y se corrige fijando la
        # IP a mano con la gateway del servidor DHCP.
        print("\n  gateway:")
        for name, c in con.items():
            gw, ip = info[name]["gw"], info[name]["ip"]
            if not gw or not ip:
                continue
            sospechosa = gw.endswith(".0") or gw.endswith(".255")
            if not sospechosa:
                print(f"    {name}: {gw}")
                continue
            # VPCS pinta la MÁSCARA en el campo gateway tras `ip dhcp`. Se pide el
            # lease y se usa el DHCP SERVER como gateway (ese dato sí lo da bien),
            # fijando la IP a mano: el arreglo queda aplicado, no solo mostrado.
            out2 = c.run("ip dhcp", "show ip", settle=5)
            ip2 = vpcs_ip(out2) or ip
            gw2 = vpcs_dhcp_server(out2)
            if not gw2:
                print(f"    {name}: gateway={gw} y sin concesión DHCP; revisa pfSense")
                continue
            mask = vpcs_mask(out2) if ip2 != ip else "255.255.255.0"
            print(f"    {name}: gateway={gw} (es la máscara) -> {gw2}, ip {ip2}")
            c.run(f"ip {ip2} {mask} {gw2}", settle=2)
            info[name]["gw"] = gw2
            info[name]["ip"] = ip2

        print("\n  conectividad:")
        names = list(con)
        chequeos = []
        for i, a in enumerate(names):
            for b in names[i + 1:]:
                if info[a]["ip"] and info[b]["ip"]:
                    chequeos.append((a, info[b]["ip"], f"{a} -> {b} (misma red)"))
        for a in names:
            gw = info[a]["gw"]
            if gw:
                chequeos.append((a, gw, f"{a} -> gateway {gw}"))
        chequeos.append((names[0], "8.8.8.8", f"{names[0]} -> 8.8.8.8 (salida)"))
        fails = 0
        for node, dst, label in chequeos:
            out = con[node].run(f"ping {dst}", settle=6)
            ok = ping_ok(out)
            fails += 0 if ok else 1
            print(f"    {'OK   ' if ok else 'FALLO'}  {label}")
        return 1 if fails else 0
    finally:
        for c in con.values():
            c.close()


def cmd_export(args, conf):
    s = Server(args.server, conf)
    proj = s.resolve(args.project)
    st, body = s.get(f"/v2/projects/{proj['project_id']}/export", raw=True, timeout=300)
    if st != 200 or not isinstance(body, bytes) or not body.startswith(b"PK"):
        print(f"export falló: [{st}] {body[:200]!r}", file=sys.stderr)
        return 1
    dest = Path(args.dest).expanduser()
    dest.write_bytes(body)
    print(f"guardado {dest} ({len(body)/1024:.0f} KB)")
    return 0


def _arreglar_startup_vpcs(zf, topo, cambios: list[str]) -> dict[str, bytes]:
    """Devuelve los ficheros del zip con los startup.vpc pidiendo DHCP.

    Un VPCS exportado de un lab local trae `ip 192.168.x.y` fijo en su startup: al
    portarlo, el PC arranca con una IP de otra red y el DHCP del destino nunca se
    usa. Cambiándolo a `ip dhcp`, cada arranque pide IP al firewall del destino.
    """
    nuevos: dict[str, bytes] = {}
    for n in topo["topology"]["nodes"]:
        if n["node_type"] != "vpcs":
            continue
        nombre = f"project-files/vpcs/{n['node_id']}/startup.vpc"
        if nombre not in zf.namelist():
            continue
        actual = zf.read(nombre).decode(errors="replace")
        if "ip dhcp" in actual:
            continue
        nuevos[nombre] = (
            f"# config de {n['name']}: pide IP al DHCP en cada arranque\n"
            f"ip dhcp\n\nset pcname {n['name']}\n"
        ).encode()
        cambios.append(f"{n['name']}: startup.vpc pasa a ip dhcp (venía con IP fija)")
    return nuevos


def _asegurar_wan(zf, topo, cambios: list[str]) -> None:
    """Añade un nodo `nat` a la primera interfaz del firewall si no hay salida.

    Un lab montado en local puede no tener nodo NAT: el firewall sale a internet por
    un bridge del host o por un cloud que se quitó al portar. Sin NAT en el destino,
    la WAN se queda sin IP y los PCs reciben «Destination host unreachable» del
    propio firewall. Aquí se crea el nodo y su enlace dentro del .gns3.
    """
    nodes = topo["topology"]["nodes"]
    if any(n["node_type"] == "nat" for n in nodes):
        return
    # ¿algún firewall/VM con al menos dos adaptadores? Es el candidato a router.
    candidato = next((n for n in nodes
                      if n["node_type"] == "qemu" and (n["properties"].get("adapters") or 0) >= 2),
                     None)
    if not candidato:
        return
    ya_enlazadas = {e.get("adapter_number") for l in topo["topology"]["links"]
                    for e in l["nodes"] if e.get("node_id") == candidato["node_id"]}
    if 0 in ya_enlazadas:
        return  # su primera interfaz ya está conectada a algo

    nat_id = str(uuid.uuid4())
    nodes.append({
        "compute_id": "local",
        "node_id": nat_id,
        "node_type": "nat",
        "name": "NAT1",
        "properties": {"ports_mapping": [
            {"interface": "virbr0", "name": "nat0", "port_number": 0, "type": "ethernet"}
        ]},
        "first_port_name": None,
        "port_name_format": "Ethernet{0}",
        "port_segment_size": 0,
        "x": -430, "y": -170, "z": 1,
        "width": 65, "height": 59,
        "symbol": ":/symbols/computer.svg",
        "label": {"text": "NAT1", "x": None, "y": -40, "rotation": 0, "style": None},
        "locked": False, "console_type": "none", "console_host": "0.0.0.0",
    })
    topo["topology"]["links"].append({
        "link_id": str(uuid.uuid4()),
        "link_type": "ethernet",
        "nodes": [
            {"adapter_number": 0, "node_id": candidato["node_id"], "port_number": 0},
            {"adapter_number": 0, "node_id": nat_id, "port_number": 0},
        ],
    })
    cambios.append(f"añadido NAT1 a la WAN de {candidato['name']} (no había salida)")



def _patch_topology(topo: dict, images: list[str], templates: list[dict],
                    imagenes_personales: list[str] | None = None) -> list[str]:
    """Corrige en el .gns3 lo que impide abrir el proyecto en otro servidor."""
    cambios = []
    nodes = topo["topology"]["nodes"]

    # 1) fuera los cloud: sus bridges son del host de origen
    fuera = {n["node_id"] for n in nodes if n["node_type"] == "cloud"}
    if fuera:
        topo["topology"]["nodes"] = [n for n in nodes if n["node_id"] not in fuera]
        antes = len(topo["topology"]["links"])
        topo["topology"]["links"] = [l for l in topo["topology"]["links"]
                                     if not any(e.get("node_id") in fuera for e in l["nodes"])]
        despues = len(topo["topology"]["links"])
        cambios.append(f"quitados {len(fuera)} nodo(s) cloud, enlaces {antes}->{despues}")

    # 2) imágenes QEMU que no existen en el destino
    disco = next((i for i in images if i.startswith("empty") and i.endswith(".qcow2")), None)
    iso = next((i for i in images if i.lower().endswith(".iso")), None)
    for n in topo["topology"]["nodes"]:
        if n["node_type"] != "qemu":
            continue
        p = n["properties"]
        p["linked_clone"] = True
        hda = p.get("hda_disk_image") or ""
        # El disco personal ya subido al destino: se usa tal cual, sin sustituirlo
        # por el vacío (perderíamos la pfSense ya configurada).
        for personal in (imagenes_personales or []):
            if hda and os.path.basename(hda) == personal:
                p["hda_disk_image"] = personal
                p["hda_disk_image_md5sum"] = ""
                p["cdrom_image"] = ""
                p["cdrom_image_md5sum"] = ""
                p["boot_priority"] = "c"
                cambios.append(f"{n['name']}: usa tu disco {personal} (ya configurado)")
                break
        else:
            if hda and hda not in images:
                if disco:
                    p["hda_disk_image"] = disco
                    p["hda_disk_image_md5sum"] = ""
                    cambios.append(f"{n['name']}: disco {hda} -> {disco}")
                    if iso and not p.get("cdrom_image"):
                        p["cdrom_image"] = iso
                        p["cdrom_image_md5sum"] = ""
                        p["boot_priority"] = "d"
                        cambios.append(f"{n['name']}: CD {iso} para instalarlo")
        cambios.append(f"{n['name']}: linked_clone activado")

    # 3) imágenes docker que el destino no tiene (tags viejos tipo chromium:dhcp)
    docker_ok = {t.get("image") for t in templates if t.get("template_type") == "docker"}
    for n in topo["topology"]["nodes"]:
        if n["node_type"] != "docker":
            continue
        img = n["properties"].get("image") or ""
        if img and img not in docker_ok:
            base = img.split(":")[0]
            alt = next((i for i in docker_ok if i and i.split(":")[0] == base), None)
            if alt:
                n["properties"]["image"] = alt
                cambios.append(f"{n['name']}: docker {img} -> {alt}")
    return cambios


def cmd_fix(args, conf):
    """Reescribe el .gns3 del proyecto en disco y lo reimporta corregido.

    No se puede editar por API porque el proyecto no abre, y PUT exige abierto.
    """
    s = Server(args.server, conf)
    proj = s.resolve(args.project)
    st, body = s.get(f"/v2/projects/{proj['project_id']}/export", raw=True, timeout=300)
    if st != 200 or not body.startswith(b"PK"):
        print(f"no puedo exportar para reparar: [{st}]", file=sys.stderr)
        return 1
    images = s.qemu_images()
    st, templates = s.get("/v2/templates")
    templates = templates if isinstance(templates, list) else []

    src = zipfile.ZipFile(io.BytesIO(body))
    topo = json.loads(src.read("project.gns3"))
    cambios = _patch_topology(topo, images, templates)
    if not cambios:
        print("no había nada que corregir")
        return 0
    for c in cambios:
        print("  " + c)

    buf = io.BytesIO()
    with zipfile.ZipFile(buf, "w", zipfile.ZIP_DEFLATED) as out:
        out.writestr("project.gns3", json.dumps(topo, indent=4))
        for name in src.namelist():
            if name == "project.gns3" or name.endswith("/"):
                continue
            out.writestr(name, src.read(name))
    buf.seek(0)

    nuevo = str(uuid.uuid4())
    st, r = s._req("POST", f"/v2/projects/{nuevo}/import", data=buf.read(),
                   ctype="application/gns3project", timeout=300)
    if st not in (200, 201):
        msg = r.get("message") if isinstance(r, dict) else r
        print(f"import corregido falló: [{st}] {msg}", file=sys.stderr)
        return 1
    nombre = proj["name"]
    if not args.keep_both:
        s.delete(f"/v2/projects/{proj['project_id']}")
        print(f"  borrado el roto ({proj['project_id'][:8]})")
        # el import genera nombre libre; lo devolvemos al original
        s.put(f"/v2/projects/{nuevo}", {"name": nombre})
    st, r = s.post(f"/v2/projects/{nuevo}/open", timeout=180)
    if st not in (200, 201):
        msg = r.get("message") if isinstance(r, dict) else r
        print(f"  aviso: importado pero no abre: [{st}] {msg}")
    print(f"  reparado como {nombre} ({nuevo[:8]})")
    return 0


def cmd_import(args, conf):
    s = Server(args.server, conf)
    path = Path(args.file).expanduser()
    if not path.is_file():
        raise SystemExit(f"no existe {path}")
    if not zipfile.is_zipfile(path):
        raise SystemExit(f"{path} no es un zip de GNS3")
    images = s.qemu_images()
    st, templates = s.get("/v2/templates")
    templates = templates if isinstance(templates, list) else []

    src = zipfile.ZipFile(path)
    topo = json.loads(src.read("project.gns3"))
    cambios = _patch_topology(topo, images, templates)
    _asegurar_wan(src, topo, cambios)
    startups = _arreglar_startup_vpcs(src, topo, cambios)
    if cambios:
        print("correcciones antes de subir:")
        for c in cambios:
            print("  " + c)
        buf = io.BytesIO()
        with zipfile.ZipFile(buf, "w", zipfile.ZIP_DEFLATED) as out:
            out.writestr("project.gns3", json.dumps(topo, indent=4))
            for name in src.namelist():
                if name == "project.gns3" or name.endswith("/"):
                    continue
                out.writestr(name, startups.get(name, src.read(name)))
        payload = buf.getvalue()
    else:
        payload = path.read_bytes()

    nuevo = str(uuid.uuid4())
    st, r = s._req("POST", f"/v2/projects/{nuevo}/import", data=payload,
                   ctype="application/gns3project", timeout=600)
    if st not in (200, 201):
        msg = r.get("message") if isinstance(r, dict) else r
        raise SystemExit(f"import falló: [{st}] {msg}")
    print(f"importado ({len(payload)/1024:.0f} KB) como id {nuevo[:8]}")
    if args.name:
        st, r = s.put(f"/v2/projects/{nuevo}", {"name": args.name})
        print(f"  renombrado a '{args.name}' [{st}]")
    st, r = s.post(f"/v2/projects/{nuevo}/open", timeout=180)
    if st in (200, 201):
        n = s.nodes(nuevo)
        print(f"  abierto: {len(n)} nodos, {len(s.links(nuevo))} enlaces")
    else:
        msg = r.get("message") if isinstance(r, dict) else r
        print(f"  aviso: no abre todavía: [{st}] {msg}")
    return 0


# --------------------------------------------------------------------------- #
# portar: local -> otro servidor, con los discos que hagan falta
# --------------------------------------------------------------------------- #
def _localizar_disco(nombre: str, compute_id: str) -> Path | None:
    """Dónde vive una imagen del servidor de origen.

    El compute local guarda las imágenes en ~/GNS3/images/QEMU; un compute remoto
    (GNS3 VM) tendría otra ruta, pero para portar desde local solo importa la primera.
    """
    rutas = [
        Path.home() / "GNS3/images/QEMU" / nombre,
        Path.home() / "GNS3/images" / nombre,
    ]
    for r in rutas:
        if r.is_file():
            return r
    return None


def _comprimir(origen: Path, destino: Path) -> Path:
    """Convierte a qcow2 comprimido: un disco de 2,3 GB baja a ~500 MB."""
    exe = shutil.which("qemu-img")
    if not exe:
        raise SystemExit("falta qemu-img: pacman -S qemu-img")
    print(f"  comprimiendo {origen.name} ({origen.stat().st_size/2**30:.1f} GB en disco)")
    r = subprocess.run([exe, "convert", "-c", "-O", "qcow2", str(origen), str(destino)],
                       capture_output=True, text=True)
    if r.returncode != 0:
        raise SystemExit(f"qemu-img convert falló: {r.stderr.strip()}")
    print(f"  -> {destino.name} ({destino.stat().st_size/2**20:.0f} MB)")
    return destino


def cmd_port(args, conf):
    """Exporta de un servidor, sube los discos que falten e importa corregido."""
    origen = Server(args.from_server, conf)
    destino = Server(args.server, conf)
    if origen.url == destino.url:
        raise SystemExit("origen y destino son el mismo servidor")

    proj = origen.resolve(args.project)
    print(f"origen : {origen.name} — {proj['name']} ({proj['project_id'][:8]})")
    print(f"destino: {destino.name} — {destino.url}")

    # El export exige el proyecto parado; se para y se deja como estaba.
    nodos = origen.nodes(proj["project_id"])
    estaban = [n["node_id"] for n in nodos if n.get("status") == "started"]
    if estaban:
        print(f"  parando {len(estaban)} nodo(s) en el origen para poder exportar")
        _set_state(origen, proj["project_id"], estaban, "stop")
        time.sleep(2)
    st, body = origen.get(f"/v2/projects/{proj['project_id']}/export", raw=True, timeout=300)
    if estaban:
        _set_state(origen, proj["project_id"], estaban, "start")
    if st != 200 or not isinstance(body, bytes) or not body.startswith(b"PK"):
        msg = body[:200] if isinstance(body, bytes) else body
        raise SystemExit(f"export del origen falló: [{st}] {msg}")
    zf = zipfile.ZipFile(io.BytesIO(body))
    topo = json.loads(zf.read("project.gns3"))
    print(f"  export: {len(body)/1024:.0f} KB, "
          f"{len(topo['topology']['nodes'])} nodos, {len(topo['topology']['links'])} enlaces")

    # Qué discos pide el proyecto y cuáles no están en el destino.
    imagenes_destino = destino.qemu_images()
    st, templates = destino.get("/v2/templates")
    templates = templates if isinstance(templates, list) else []
    faltan: dict[str, str] = {}   # nombre destino -> ruta local
    for n in topo["topology"]["nodes"]:
        if n["node_type"] != "qemu":
            continue
        for campo in ("hda_disk_image", "hdb_disk_image"):
            img = (n["properties"].get(campo) or "").strip()
            if not img or os.path.basename(img) in imagenes_destino:
                continue
            local = _localizar_disco(os.path.basename(img), n.get("compute_id", "local"))
            if local:
                faltan[os.path.basename(img)] = str(local)

    # Subida de los discos que falten (una sola vez por nombre).
    subidos = []
    if faltan:
        print(f"  discos que faltan en el destino: {', '.join(faltan)}")
        for nombre, ruta in faltan.items():
            payload = Path(ruta)
            if args.compress:
                tmp = Path("/tmp") / f"port-{nombre}"
                if tmp.suffix != ".qcow2":
                    tmp = tmp.with_suffix(".qcow2")
                payload = _comprimir(Path(ruta), tmp)
            print(f"  subiendo {nombre} ({payload.stat().st_size/2**20:.0f} MB)...")
            with open(payload, "rb") as f:
                st, r = destino._req("POST", f"/v2/computes/local/qemu/images/{nombre}",
                                     data=f.read(), ctype="application/octet-stream",
                                     timeout=1800)
            if st not in (200, 201, 204):
                raise SystemExit(f"  subida de {nombre} falló: [{st}] {r}")
            subidos.append(nombre)
            print("    OK")
            imagenes_destino = destino.qemu_images()

    # Reescribir el .gns3 con las correcciones del destino.
    cambios = _patch_topology(topo, imagenes_destino, templates,
                              imagenes_personales=subidos or list(faltan))

    _asegurar_wan(zf, topo, cambios)
    startups = _arreglar_startup_vpcs(zf, topo, cambios)
    if cambios:
        print("  correcciones:")
        for c in cambios:
            print("    " + c)
    buf = io.BytesIO()
    with zipfile.ZipFile(buf, "w", zipfile.ZIP_DEFLATED) as out:
        out.writestr("project.gns3", json.dumps(topo, indent=4))
        for name in zf.namelist():
            if name == "project.gns3" or name.endswith("/"):
                continue
            out.writestr(name, startups.get(name, zf.read(name)))

    nuevo = str(uuid.uuid4())
    st, r = destino._req("POST", f"/v2/projects/{nuevo}/import", data=buf.getvalue(),
                         ctype="application/gns3project", timeout=600)
    if st not in (200, 201):
        msg = r.get("message") if isinstance(r, dict) else r
        raise SystemExit(f"import en el destino falló: [{st}] {msg}")
    nombre = args.name or proj["name"]
    destino.put(f"/v2/projects/{nuevo}", {"name": nombre})
    print(f"  importado como '{nombre}' ({nuevo[:8]})")

    st, r = destino.post(f"/v2/projects/{nuevo}/open", timeout=180)
    if st in (200, 201):
        print(f"  abierto: {len(destino.nodes(nuevo))} nodos, {len(destino.links(nuevo))} enlaces")
    else:
