            raise SystemExit("add exige dos nodos: gns3lab link add R1 R2")
        a = c.find_node(pid, args.nodes[0])
        b = c.find_node(pid, args.nodes[1])
        body = {"nodes": [
            {"node_id": a["node_id"], "adapter_number": args.pa, "port_number": args.ppa},
            {"node_id": b["node_id"], "adapter_number": args.pb, "port_number": args.ppb},
        ]}
