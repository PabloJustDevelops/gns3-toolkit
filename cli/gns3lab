class Vpcs:
    """Consola telnet de un VPCS: manda un comando y devuelve la salida limpia."""

    ANSI = re.compile(r"\x1b\[[0-9;?]*[a-zA-Z]|\x1b\][^\x07]*\x07")

    def __init__(self, host: str, port: int, timeout: float = 10.0):
        self.sock = socket.create_connection((host, port), timeout=timeout)
        self.sock.settimeout(0.4)
        self.cerrada = False
        self.host = host
        self.port = port

    def _drain(self, seconds: float) -> bytes:
        buf = b""
        end = time.time() + seconds
        while time.time() < end:
            try:
                chunk = self.sock.recv(65535)
                if not chunk:
                    break
                buf += chunk
            except socket.timeout:
                continue
            except OSError:
                break
        return buf

    def run(self, *cmds: str, settle: float = 5.0) -> str:
        """Manda comandos y devuelve la salida. Tolera que la consola se cierre.

        Algunos comandos (`dhcp`) devuelven tal cantidad de datos que el servidor
        cierra el socket; sin este manejo, el cliente revienta con BrokenPipe y se
        pierde la salida ya recibida.
        """
        buf = self._drain(0.6)
        try:
            self.sock.sendall(b"\n")
            buf += self._drain(1.2)
            for c in cmds:
                self.sock.sendall(c.encode() + b"\n")
                buf += self._drain(settle)
        except (BrokenPipeError, ConnectionResetError, OSError):
            self.cerrada = True
        return self.ANSI.sub("", buf.decode(errors="replace")).replace("\r", "")

    def close(self):
        try:
            self.sock.close()
        except OSError:
            pass


def vpcs_ip(text: str) -> str | None:
    m = re.search(r"IP/MASK\s*:\s*(\d+\.\d+\.\d+\.\d+)", text)
    return m.group(1) if m else None


def vpcs_gateway(text: str) -> str | None:
    m = re.search(r"GATEWAY\s*:\s*(\d+\.\d+\.\d+\.\d+)", text)
    return m.group(1) if m else None


def vpcs_dhcp_server(text: str) -> str | None:
    """El propio VPCS dice quién le dio la IP: ese es el gateway de la VLAN."""
    m = re.search(r"DHCP SERVER\s*:\s*(\d+\.\d+\.\d+\.\d+)", text)
    return m.group(1) if m else None


def vpcs_mask(text: str) -> str:
    m = re.search(r"IP/MASK\s*:\s*[\d.]+/(\d+)", text)
    if not m:
        return "255.255.255.0"
    bits = int(m.group(1))
    partes = [(0xFFFFFFFF << (32 - bits) >> (8 * (3 - i))) & 0xFF for i in range(4)]
    return ".".join(str(x) for x in partes)


def ping_ok(text: str) -> bool:
    return "bytes from" in text.lower() or bool(re.search(r"\b\d+ bytes\b.*time", text))


