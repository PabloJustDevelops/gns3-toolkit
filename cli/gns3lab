def _err(body) -> str:
    """Mensaje corto de error de la API (evita el volcado de schema anidado)."""
    msg = body.get("message") if isinstance(body, dict) else str(body)
    if isinstance(msg, str) and "JSON schema error" in msg:
        inner = msg[msg.find("{"):]
        m = re.search(r'"message"\s*:\s*"([^"]+)"', inner)
        if m:
            return m.group(1)[:300]
    return str(msg)[:400]


def cmd_node(args, conf):
    """Nodos: add (plantilla), rm, dup, props, switch (VLANs), disk (clonar qcow2)."""
    s = Server(args.server, conf)
    c = _core_client(s)
    proj = c.resolve_project(args.project)
    pid = proj["project_id"]
    c.ensure_open(pid)
    act = args.action

    if act == "add":
        if not args.template:
            raise SystemExit("add exige --template")
        tpl = next((t for t in c.templates()
                    if t.get("template_id") == args.template
                    or str(t.get("name", "")).lower() == args.template.lower()), None)
        if not tpl:
            raise SystemExit(f"plantilla no encontrada: {args.template}")
        st, body = c.post(f"/v2/projects/{pid}/templates/{tpl['template_id']}",
                          {"x": args.x, "y": args.y, "compute_id": "local"})
        if st not in (200, 201):
            msg = _err(body)
            print(f"no se pudo añadir: [{st}] {msg}", file=sys.stderr)
            if "NAT interface" in msg or "libvirt" in msg:
                print("  → el nodo NAT usa una red libvirt (gns3-nat*): "
                      "`sudo systemctl start libvirtd` y reintenta", file=sys.stderr)
            return 1
        nid = body["node_id"]
        if args.name:
            c.put(f"/v2/projects/{pid}/nodes/{nid}", {"name": args.name})
        print(f"{args.name or body['name']} ({nid[:8]}) tipo={body.get('node_type')}")
        return 0

    if not args.node:
        raise SystemExit(f"{act} exige el nombre del nodo")
    node = c.find_node(pid, args.node)
    nid = node["node_id"]

    if act in ("start", "stop", "reload", "suspend"):
        want = {"start": "started", "stop": "stopped", "reload": "started",
                "suspend": "suspended"}[act]
        st, body = c.node_action(pid, nid, act)
        if st not in (200, 201, 204):
            print(f"{node['name']} {act} falló: [{st}] {_err(body)}", file=sys.stderr)
            return 1
        estado = _wait_node_status(c, pid, nid, want, timeout=args.wait)
        ok = estado == want
        print(f"{node['name']}: {act} -> status={estado}"
              + ("" if ok else f" (no llegó a {want} en {args.wait:.0f} s)"))
        return 0 if ok else 1

    if act == "line":
        cmdline = c.node_command_line(pid, nid)
        if not cmdline:
            print(f"{node['name']}: la API no devuelve command_line", file=sys.stderr)
            return 1
        print(cmdline)
        return 0

    if act == "rm":
        st, _ = c.delete(f"/v2/projects/{pid}/nodes/{nid}", timeout=120)
        print(f"{node['name']} borrado={st in (200, 204)}")
        return 0 if st in (200, 204) else 1

    if act == "dup":
        st, body = c.post(f"/v2/projects/{pid}/nodes/{nid}/duplicate",
                          {"x": args.x, "y": args.y, "name": args.name}, timeout=180)
        if st not in (200, 201):
            print(f"duplicate falló: [{st}] {body}", file=sys.stderr)
            return 1
        print(f"duplicado como {body.get('name')} ({body['node_id'][:8]})")
        return 0

    if act == "props":
        if not args.set:
            raise SystemExit("props exige --set clave=valor (repetible)")
        # `console`, `name`, `x`, `y`... son campos del nodo, no de properties:
        # dentro de properties se aceptan y no cambian nada (200 mentiroso).
        TOP = {"name", "console", "console_type", "x", "y", "z", "symbol", "locked"}
        props: dict = {}
        top: dict = {}
        for kv in args.set:
            if "=" not in kv:
                raise SystemExit(f"--set espera clave=valor, no {kv}")
            k, v = kv.split("=", 1)
            (top if k in TOP else props)[k] = _kv_value(v)
        body: dict = {}
        if props:
            body["properties"] = props
        body.update(top)
        st, body_res = c.put(f"/v2/projects/{pid}/nodes/{nid}", body, timeout=120)
        ok = st in (200, 201)
        print(f"{node['name']}: {body} -> {'OK' if ok else _err(body_res)}")
        return 0 if ok else 1

    if act == "switch":
        """VLANs del switch: `--port 1=access:20 --port 0=dot1q:43`."""
        cur = (node.get("properties") or {}).get("ports_mapping") or []
        mapping = [dict(p) for p in cur]
        for spec in args.port:
            if "=" not in spec:
                raise SystemExit(f"--port espera N=tipo[:vlan], no {spec}")
            idx, val = spec.split("=", 1)
            kind, _, vlan = val.partition(":")
            idx = int(idx)
            while len(mapping) <= idx:
                n = len(mapping)
                mapping.append({"name": f"Ethernet{n}", "port_number": n,
                                "type": "access", "vlan": 1, "ethertype": ""})
            mapping[idx] = {"name": mapping[idx].get("name", f"Ethernet{idx}"),
                            "port_number": idx,
                            "type": kind, "vlan": int(vlan) if vlan else 1,
                            "ethertype": ""}
        st, body = c.put(f"/v2/projects/{pid}/nodes/{nid}",
                         {"properties": {"ports_mapping": mapping}}, timeout=120)
        ok = st in (200, 201)
        print(f"{node['name']}: {len(mapping)} puertos -> {'OK' if ok else _err(body)}")
        return 0 if ok else 1

    if act == "disk":
        src_name = args.from_disk or (node.get("properties") or {}).get("hda_disk_image")
        if not src_name:
            raise SystemExit("disk exige --from o un nodo con hda_disk_image")
        images = Path.home() / "GNS3/images/QEMU"
        src = images / os.path.basename(src_name)
        if not src.exists():
            raise SystemExit(f"no existe {src}")
        dst_name = args.name or f"{src.stem}-{time.strftime('%H%M%S')}.qcow2"
        dst = images / dst_name
        if dst.exists():
            raise SystemExit(f"ya existe {dst}")
        qemu_img = shutil.which("qemu-img")
        print(f"clonando {src.name} ({src.stat().st_size/2**20:.0f} MB) -> {dst_name}")
        if qemu_img:
            r = subprocess.run([qemu_img, "convert", "-O", "qcow2", str(src), str(dst)],
                               capture_output=True, text=True)
            if r.returncode != 0:
                raise SystemExit(f"qemu-img falló: {r.stderr.strip()}")
        else:
            shutil.copy2(src, dst)
        st, body = c.put(f"/v2/projects/{pid}/nodes/{nid}",
                         {"properties": {"hda_disk_image": dst_name,
                                         "hda_disk_image_md5sum": "",
                                         "linked_clone": False}}, timeout=120)
        print(f"{dst_name} ({dst.stat().st_size/2**20:.0f} MB) enlazado={st in (200, 201)}")
        return 0 if st in (200, 201) else 1

    raise SystemExit(f"acción desconocida: {act}")


def cmd_upload(args, conf):
    """Sube un qcow2/iso al servidor (comprimido si es qcow2)."""
    s = Server(args.server, conf)
    c = _core_client(s)
    src = Path(args.file).expanduser()
    if not src.is_file():
        raise SystemExit(f"no existe {src}")
    name = args.name or src.name
    payload, tmp = src, None
    if args.compress and src.suffix.lower() == ".qcow2" and shutil.which("qemu-img"):
        tmp = Path("/tmp") / f"upload-{src.stem}.qcow2"
        print(f"comprimiendo {src.name} ({src.stat().st_size/2**20:.0f} MB)")
        r = subprocess.run(["qemu-img", "convert", "-c", "-O", "qcow2", str(src), str(tmp)],
                           capture_output=True, text=True)
        if r.returncode == 0:
            payload = tmp
            print(f"  -> {tmp.stat().st_size/2**20:.0f} MB")
        else:
            tmp = None
    data = payload.read_bytes()
    print(f"subiendo {name} ({len(data)/2**20:.0f} MB)")
    st, body = c.compute_write_file("local", "qemu", name, data)
    if tmp:
        tmp.unlink(missing_ok=True)
    if st not in (200, 201, 204):
        print(f"subida falló: [{st}] {body}", file=sys.stderr)
        return 1
    listed = [i.get("filename") for i in c.qemu_images()]
    print(f"OK: {name} {'verificado' if name in listed else 'NO aparece en la lista'}"
          f" ({len(listed)} imágenes en el servidor)")
    return 0 if name in listed else 1


def _draw_text(svg: str) -> str:
    """Texto visible de una nota SVG, para listarla sin volcar el SVG entero."""
    trozos = re.findall(r"<text[^>]*>(.*?)</text>", svg or "", re.S)
    return " | ".join(re.sub(r"<[^>]+>", "", t).strip() for t in trozos if t.strip())


DRAW_FIELDS = {"x", "y", "z", "rotation", "locked", "svg"}


def cmd_draw(args, conf):
    """Notas del canvas: crear con texto, list, edit <id> --set k=v y rm <id>."""
    s = Server(args.server, conf)
    c = _core_client(s)
    proj = c.resolve_project(args.project)
    pid = proj["project_id"]
    c.ensure_open(pid)
    palabras = args.text
    act = palabras[0].lower() if palabras else "list"

    if act in ("list", "ls"):
        notas = c.drawings(pid)
        if not notas:
            print("  sin notas")
            return 0
        for d in notas:
            texto = _draw_text(d.get("svg", "")) or "(sin texto)"
            print(f"  {str(d.get('drawing_id'))[:8]}  x={d.get('x')} y={d.get('y')}  "
                  f"{texto[:72]}")
        return 0

    if act in ("edit", "rm"):
        if len(palabras) < 2:
            raise SystemExit(f"{act} exige el drawing_id "
                             "(míralos con `gns3lab draw list`)")
        nota = _resolve_id(c.drawings(pid), palabras[1], "drawing_id", "nota")
        did = nota["drawing_id"]
        if act == "rm":
            st, res = c.drawing_delete(pid, did)
            if st not in (200, 204):
                print(f"no se pudo borrar la nota {did[:8]}: [{st}] {_err(res)}",
                      file=sys.stderr)
                return 1
            print(f"nota {did[:8]} borrada; quedan {len(c.drawings(pid))}")
            return 0
        body = _set_body(args.set)
        if not body:
            raise SystemExit("edit exige --set clave=valor (repetible)")
        raros = sorted(set(body) - DRAW_FIELDS)
        if raros:
            raise SystemExit(f"campos no editables en una nota: {', '.join(raros)}. "
                             f"Válidos: {', '.join(sorted(DRAW_FIELDS))}")
        st, res = c.drawing_update(pid, did, body)
        if st not in (200, 201):
            print(f"no se pudo editar la nota {did[:8]}: [{st}] {_err(res)}",
                  file=sys.stderr)
            return 1
        # Releer: un 200 del PUT no prueba que el campo haya cambiado.
        st, check = c.get(f"/v2/projects/{pid}/drawings/{did}")
        if st != 200 or not isinstance(check, dict):
            print(f"editada {did[:8]}, pero no puedo releerla: [{st}] {_err(check)}",
                  file=sys.stderr)
            return 1
        print(f"nota {did[:8]}: " + ", ".join(f"{k}={check.get(k)!r}" for k in body))
        malos = {k: {"pedido": v, "leído": check.get(k)}
                 for k, v in body.items() if check.get(k) != v}
        if malos:
            print(f"  la API no aplicó: {malos}", file=sys.stderr)
            return 1
        return 0

    texto = " ".join(palabras)
    w = max(220, 9 * len(texto))
    svg = (f'<svg width="{w}" height="60" viewBox="0 0 {w} 60" xmlns="http://www.w3.org/2000/svg">'
           f'<rect width="{w}" height="60" fill="none" stroke="{args.color}" stroke-width="2" rx="6"/>'
           f'<text x="8" y="24" font-size="14" fill="{args.color}">'
           f'{texto.replace("&", "&amp;").replace("<", "&lt;")}</text></svg>')
    st, body = c.drawing_create(pid, {"x": args.x, "y": args.y, "z": 0,
                                      "rotation": 0, "svg": svg})
    ok = st in (200, 201)
    if not ok:
        print(f"no se pudo crear la nota: [{st}] {_err(body)}", file=sys.stderr)
        return 1
    did = str(body.get("drawing_id") or "") if isinstance(body, dict) else ""
    print(f"nota creada {did[:8]}")
    return 0


def cmd_link(args, conf):
    """Enlaces: list, add <nodoA> <nodoB> [--pa N --pb N], rm <link_id>, edit."""
    s = Server(args.server, conf)
    c = _core_client(s)
    proj = c.resolve_project(args.project)
    pid = proj["project_id"]
    c.ensure_open(pid)
    if args.action == "list":
        names = {n["node_id"]: n["name"] for n in c.nodes(pid)}
        for l in c.links(pid):
            ends = " <-> ".join(
                f"{names.get(e['node_id'], '?')}:{e['adapter_number']}/{e['port_number']}"
                for e in l.get("nodes", []))
            print(f"  {l['link_id'][:8]}  {ends}")
        return 0
    if args.action == "add":
        if len(args.nodes) != 2:
            raise SystemExit("add exige dos nodos: gns3lab link add R1 R2")
        a = c.find_node(pid, args.nodes[0])
        b = c.find_node(pid, args.nodes[1])
        body = {"nodes": [
            {"node_id": a["node_id"], "adapter_number": args.pa, "port_number": args.ppa},
            {"node_id": b["node_id"], "adapter_number": args.pb, "port_number": args.ppb},
        ]}
        st, res = c.post(f"/v2/projects/{pid}/links", body)
        if st not in (200, 201):
            print(f"enlace falló: [{st}] {_err(res)}", file=sys.stderr)
            return 1
        print(f"{a['name']}:{args.pa}/{args.ppa} <-> {b['name']}:{args.pb}/{args.ppb}  "
              f"({res.get('link_id', '')[:8]})")
        return 0
    if args.action in ("rm", "edit"):
        if not args.nodes:
            raise SystemExit(f"{args.action} exige el link_id")
        enlace = _resolve_id(c.links(pid), args.nodes[0], "link_id", "enlace")
        lid = enlace["link_id"]
        if args.action == "rm":
            st, res = c.link_delete(pid, lid)
            print(f"borrado={st in (200, 204)}"
                  + ("" if st in (200, 204) else f" [{st}] {_err(res)}"))
            return 0 if st in (200, 204) else 1
        body = _set_body(args.set)
        if not body:
            raise SystemExit("edit exige --set clave=valor (repetible)")
        st, res = c.link_update(pid, lid, body)
        if st not in (200, 201):
            print(f"no se pudo editar el enlace {lid[:8]}: [{st}] {_err(res)}",
                  file=sys.stderr)
            return 1
        # Se relee el enlace: el 200 del PUT no prueba que el campo haya cambiado.
        st, check = c.get(f"/v2/projects/{pid}/links/{lid}")
        if st != 200 or not isinstance(check, dict):
            print(f"editado {lid[:8]}, pero no puedo releerlo: [{st}] {_err(check)}",
                  file=sys.stderr)
            return 1
        print(f"enlace {lid[:8]}: " + ", ".join(f"{k}={check.get(k)!r}" for k in body))
        malos = {k: {"pedido": v, "leído": check.get(k)}
                 for k, v in body.items() if check.get(k) != v}
        if malos:
            print(f"  la API no aplicó: {malos}", file=sys.stderr)
            return 1
        return 0
    raise SystemExit(f"acción desconocida: {args.action}")


def cmd_capture(args, conf):
    """Captura de un enlace: start, stop y descarga del pcap.

    Sólo arranca o para la captura que se le pide; no toca nada más del proyecto.
    """
    s = Server(args.server, conf)
    c, proj = _core_project(s, args.project)
    pid = proj["project_id"]
    enlace = _resolve_id(c.links(pid), args.link, "link_id", "enlace")
    lid = enlace["link_id"]
    act = args.action

    if act == "start":
        st, res = c.link_capture(pid, lid, "start")
        if st not in (200, 201):
            print(f"no se pudo iniciar la captura de {lid[:8]}: [{st}] {_err(res)}",
                  file=sys.stderr)
            return 1
        st2, check = c.get(f"/v2/projects/{pid}/links/{lid}")
        estado = check.get("capturing") if isinstance(check, dict) else None
        nombre = check.get("capture_file_name") if isinstance(check, dict) else None
        print(f"captura iniciada en {lid[:8]} -> capturing={estado} "
              f"({nombre or 'sin nombre'})")
        print(f"  párala con `gns3lab capture {lid[:8]} stop`")
        return 0

    if act == "stop":
        st, res = c.link_capture(pid, lid, "stop")
        ok = st in (200, 201, 204)
        if not ok:
            print(f"no se pudo parar la captura de {lid[:8]}: [{st}] {_err(res)}",
                  file=sys.stderr)
            return 1
        st2, check = c.get(f"/v2/projects/{pid}/links/{lid}")
        estado = check.get("capturing") if isinstance(check, dict) else None
        print(f"captura parada en {lid[:8]} -> capturing={estado}")
        return 0

    if act == "pcap":
        st, data = c.link_capture(pid, lid, "pcap")
        if st != 200 or not isinstance(data, bytes) or not data:
            detalle = data.decode(errors="replace")[:200] if isinstance(data, bytes) else data
            # Con la captura parada la API puede dar 409: el fichero queda en el proyecto.
            proyecto = c.project_get(pid)
            base = Path(proyecto.get("path") or "") if isinstance(proyecto, dict) else None
            cands = sorted((base / "project-files" / "captures").glob("*.pcap"),
                           key=lambda p: p.stat().st_mtime, reverse=True) \
                if base and base.is_dir() else []
            if not cands:
                print(f"no pude descargar el pcap de {lid[:8]}: [{st}] {detalle}",
                      file=sys.stderr)
                return 1
            data = cands[0].read_bytes()
            print(f"  aviso: GET .../pcap -> [{st}] {detalle}; uso {cands[0].name}",
                  file=sys.stderr)
        destino_dir = Path.home() / "GNS3/captures"
        destino_dir.mkdir(parents=True, exist_ok=True)
        destino = destino_dir / f"cap-{time.strftime('%Y%m%d-%H%M%S')}-{lid[:8]}.pcap"
        destino.write_bytes(data)
        print(f"{destino}  ({len(data)/1024:.1f} KB)")
        return 0

    raise SystemExit(f"acción de captura desconocida: {act}")


def _emit_doctor(report: dict, lineas: list[str], as_json: bool) -> None:
    if as_json:
        print(json.dumps(report, ensure_ascii=False, indent=2))
    else:
        for linea in lineas:
            print(linea)


def cmd_doctor(args, conf):
    """Chequeo integral antes de dar un lab por bueno."""
    s = Server(args.server, conf)
    problemas: list[str] = []
    lineas: list[str] = []
    report: dict = {"server": {"name": s.name, "url": s.url}, "problems": problemas}

    def say(texto: str = "") -> None:
        lineas.append(texto)

    say(f"servidor {s.name} ({s.url})")
    if not s.alive():
        if args.json:
            report.update({"alive": False, "ok": False})
            print(json.dumps(report, ensure_ascii=False, indent=2))
        else:
            print("  NO responde: arráncalo (gns3server) antes de nada", file=sys.stderr)
        return 2
    report["alive"] = True
    st, ver = s.get("/v2/version")
    version = ver.get("version") if isinstance(ver, dict) else "?"
    report["version"] = version
    say(f"  versión {version}")
    st, computes = s.get("/v2/computes")
    computes = computes if isinstance(computes, list) else []
    report["computes"] = [{"name": c.get("name"), "connected": bool(c.get("connected"))}
                          for c in computes]
    for comp in computes:
        ok = comp.get("connected")
        say(f"  compute {comp.get('name')}: {'conectado' if ok else 'DESCONECTADO'}")
        if not ok:
            problemas.append(f"compute {comp.get('name')} desconectado")
    herramientas: dict[str, bool] = {}
    for b in ("tesseract", "qemu-img", "tshark", "sshpass"):
        presente = bool(shutil.which(b))
        herramientas[b] = presente
        say(f"  {b:<10} {'OK' if presente else 'falta'}")
        if b == "tesseract" and not presente:
            problemas.append("sin tesseract: `gns3lab shot` no puede dar texto")
    report["tools"] = herramientas
    lv = subprocess.run(["systemctl", "is-active", "libvirtd"],
                        capture_output=True, text=True).stdout.strip()
    report["libvirtd"] = lv or None
    say(f"  libvirtd   {lv or 'desconocido'}")
    if lv != "active":
        problemas.append("libvirtd parado: los nodos NAT no arrancan "
                         "(`sudo systemctl start libvirtd`)")
    try:
        import PIL  # noqa: F401
        report["pillow"] = True
        say("  Pillow     OK")
    except ImportError:
        report["pillow"] = False
        problemas.append("sin Pillow: el screendump queda en PPM")

    projs = s.projects()
    try:
        target = s.resolve(args.project)
    except SystemExit:
        target = None
    if not target:
        report["projects"] = {"count": len(projs), "selected": None}
        say(f"  {len(projs)} proyectos, ninguno seleccionable")
        report["nodes"] = []
        report["ok"] = False
        _emit_doctor(report, lineas, args.json)
        return 1
    say(f"  proyecto {target['name']} ({target['project_id'][:8]}, {target.get('status')})")
    report["projects"] = {"count": len(projs), "selected": target["name"],
                          "project_id": target["project_id"],
                          "status": target.get("status")}
    if target.get("status") != "opened":
        say("    aviso: cerrado; `gns3lab up` lo abre")
    nodes = s.nodes(target["project_id"])
    discos: dict[str, list[str]] = {}
    report["nodes"] = []
    for n in nodes:
        props = n.get("properties") or {}
        hda = props.get("hda_disk_image") or ""
        cons = n.get("console")
        say(f"    {n['name']:<18} {n['node_type']:<16} {(n.get('status') or '-'):<9} "
            f"console={cons} ({n.get('console_type')})")
        report["nodes"].append({"name": n["name"], "node_type": n["node_type"],
                                "status": n.get("status"), "console": cons,
                                "console_type": n.get("console_type"),
                                "hda_disk_image": hda or None})
        if hda:
            discos.setdefault(hda, []).append(n["name"])
        if n.get("status") != "started":
            problemas.append(f"{n['name']} no está arrancado")
        if n["node_type"] == "qemu" and n.get("status") == "started":
            mon = core.find_monitor_port(n["node_id"], hda)
            if not mon:
                problemas.append(f"{n['name']}: sin monitor HMP visible (¿proceso de otro usuario?)")
    imgs = s.qemu_images()          # Server.qemu_images() devuelve nombres
    for img, quienes in discos.items():
        if len(quienes) > 1:
            problemas.append(f"disco compartido {img} entre {quienes}: un cambio de config afecta a los dos")
        if img not in imgs:
            problemas.append(f"imagen ausente en el servidor: {img}")
    nat = any(n["node_type"] == "nat" for n in nodes)
    if not nat:
        problemas.append("sin nodo NAT: la WAN se quedará sin IP (usa `gns3lab node add --template NAT`)")
    say("")
    say("  resumen")
    if problemas:
        for p in problemas:
            say(f"    - {p}")
        report["ok"] = False
        _emit_doctor(report, lineas, args.json)
        return 1
    say("    sin hallazgos")
    report["ok"] = True
    _emit_doctor(report, lineas, args.json)
    return 0


def main() -> int:
    conf = load_conf()
    if not CONF.exists():
        CONF.parent.mkdir(parents=True, exist_ok=True)
        CONF.write_text(json.dumps(DEFAULT_CONF, indent=2))
    ap = argparse.ArgumentParser(prog="gns3lab", description=__doc__.split("\n")[0])
    ap.add_argument("--server", "-s", default=conf.get("default_server", "local"))
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("servers", help="servidores configurados y estado")

    p = sub.add_parser("compute", help="compute(s): conexión, CPU y memoria")
    p.add_argument("cid", nargs="?", help="compute_id o nombre (sin él, todos)")
    p.add_argument("--json", action="store_true", help="salida JSON")

    p = sub.add_parser("stats", help="estadísticas del servidor")
    p.add_argument("--json", action="store_true", help="salida JSON")

    p = sub.add_parser("symbols", help="símbolos de dispositivo del servidor")
    p.add_argument("--filter", help="texto en el id, el fichero o el tema")
    p.add_argument("--json", action="store_true", help="salida JSON")

    p = sub.add_parser("appliances", help="appliances del catálogo GNS3")
    p.add_argument("--filter", help="texto en nombre, categoría o descripción")
    p.add_argument("--json", action="store_true", help="salida JSON")

    for name, help_ in (("status", "proyectos y nodos"), ("up", "abre y arranca todo"),
                        ("down", "para todo"), ("test", "conectividad de las VPCS"),
                        ("fix", "repara un proyecto importado")):
        p = sub.add_parser(name, help=help_)
        p.add_argument("project", nargs="?", help="nombre o id del proyecto")
        if name == "down":
            p.add_argument("--keep-open", action="store_true", help="no cerrar el proyecto")
        if name == "fix":
            p.add_argument("--keep-both", action="store_true", help="no borrar el proyecto roto")

    p = sub.add_parser("export", help="guarda un .gns3p")
    p.add_argument("dest")
    p.add_argument("project", nargs="?")

    p = sub.add_parser("import", help="importa un .gns3p corrigiéndolo")
    p.add_argument("file")
