def cmd_servers(args, conf):
    for name in conf.get("servers", {}):
        s = Server(name, conf)
        ok = s.alive()
        mark = "OK " if ok else "NO "
        extra = ""
        if ok:
            st, body = s.get("/v2/version")
            ver = body.get("version") if isinstance(body, dict) else "?"
            n = len(s.projects())
            extra = f"v{ver}, {n} proyecto(s), auth={'sí' if s.auth else 'no'}"
        print(f"  [{mark}] {name:<8} {s.url:<32} {extra}")
    return 0


def cmd_status(args, conf):
    s = Server(args.server, conf)
    if not s.alive():
        print(f"servidor {s.name} ({s.url}) no responde", file=sys.stderr)
        return 2
    projects = s.projects()
    try:
        target = s.resolve(args.project)
    except SystemExit:
        target = None
    for p in projects:
        opened = "abierto" if p.get("status") == "opened" else "cerrado"
        star = " *" if target and p["project_id"] == target["project_id"] else "  "
        print(f"{star} {p['name']:<32} {opened:<8} {p['project_id'][:8]}")
        if target and p["project_id"] == target["project_id"]:
            for n in s.nodes(p["project_id"]):
                st = n.get("status") or "-"
                cons = n.get("console_type") or "-"
                print(f"      {n['name']:<16} {n['node_type']:<16} {st:<9} {cons}:{n.get('console')}")
    return 0


def _set_state(s: Server, pid: str, ids: list[str], action: str) -> int:
    fails = 0
    for nid in ids:
        st, body = s.post(f"/v2/projects/{pid}/nodes/{nid}/{action}", timeout=180)
        if st not in (200, 201, 204):
            msg = body.get("message") if isinstance(body, dict) else body
            print(f"    fallo en {nid[:8]}: [{st}] {msg}")
            fails += 1
    return fails


def _wait_node_status(c, pid: str, nid: str, want: str, timeout: float = 45.0) -> str:
    """Relee el nodo hasta que la API confirme `want` (un 200 no prueba nada)."""
    end = time.time() + timeout
    last = None
    while True:
        st, detail = c.get(f"/v2/projects/{pid}/nodes/{nid}")
        if st == 200 and isinstance(detail, dict):
            last = detail.get("status")
            if last == want:
                return last
        if time.time() >= end:
            return last or "?"
        time.sleep(1.0)


def _json_out(obj) -> None:
    print(json.dumps(obj, ensure_ascii=False, indent=2, default=str))


def _ok(st) -> bool:
    return st in (200, 201, 204)


def _confirm(args, what: str) -> bool:
    """Acciones destructivas: exigen --yes o confirmación por TTY."""
    if getattr(args, "yes", False):
        return True
    if not sys.stdin.isatty():
        print(f"{what} es irreversible y stdin no es un TTY: repite con --yes",
              file=sys.stderr)
        return False
    if input(f"¿{what}? [y/N] ").strip().lower() not in ("y", "s", "si", "sí", "yes"):
        print("cancelado")
        return False
    return True


def _print_data(titulo: str, data, indent: str = "  ") -> None:
    """Muestra un dict/lista de la API sin volcar JSON anidado."""
    def valor(v):
        if isinstance(v, (dict, list)):
            return json.dumps(v, ensure_ascii=False, default=str)
        return v

    print(titulo)
    if isinstance(data, dict):
        if not data:
            print(f"{indent}(vacío)")
        for k in sorted(data):
            print(f"{indent}{str(k):<22} {valor(data[k])}")
    elif isinstance(data, list):
        if not data:
            print(f"{indent}(vacío)")
        for i, v in enumerate(data):
            print(f"{indent}[{i}] {valor(v)}")
    else:
        print(f"{indent}{data}")


def _core_call(fn, *a, **kw):
    """Llama al núcleo y convierte un corte de red en un error legible.

    El servidor puede reiniciarse a mitad de una consulta larga (`/v2/appliances`
    devuelve un JSON grande): sin esto sale un traceback de `ConnectionReset`.
    """
    try:
        return fn(*a, **kw)
    except BrokenPipeError:
        raise                     # stdout cerrado (| head): no es un fallo de red
    except (ConnectionError, TimeoutError) as e:
        raise SystemExit(f"fallo de conexión con el servidor: {e}")


