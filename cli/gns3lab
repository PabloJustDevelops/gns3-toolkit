def cmd_project(args, conf):
    """Proyectos: duplicate, load, stats y ficheros (get|put)."""
    s = Server(args.server, conf)
    c = _core_client(s)
    act = args.action

    if act == "duplicate":
        if not args.target:
            raise SystemExit("duplicate exige el nombre del proyecto nuevo")
        if not _confirm(args, f"duplicar el proyecto como '{args.target}'"):
            return 1
        # El proyecto de origen se elige con -p (o el único abierto).
        proj = c.resolve_project(args.project)
        st, res = _core_call(c.project_duplicate, proj["project_id"], args.target)
        if not _ok(st):
            print(f"no se pudo duplicar '{proj['name']}': [{st}] {_err(res)}",
                  file=sys.stderr)
            return 1
        print(f"duplicado: {res.get('name', args.target)} "
              f"({str(res.get('project_id'))[:8]})"
              if isinstance(res, dict) else f"duplicado [{st}]")
        return 0

    if act == "load":
        if not args.target:
            raise SystemExit("load exige la ruta del fichero .gns3")
        ruta = str(Path(args.target).expanduser())
        st, res = _core_call(c.project_load, ruta)
        if not _ok(st) and st != 200:
            print(f"load de '{ruta}' falló: [{st}] {_err(res)}", file=sys.stderr)
            return 1
        print(f"cargado: {res.get('name', '?')} ({str(res.get('project_id'))[:8]})"
              if isinstance(res, dict) else f"cargado '{ruta}' [{st}]")
        return 0

    if act == "stats":
        proj = c.resolve_project(args.project)
        st, res = _core_call(c.project_stats, proj["project_id"])
        if st != 200:
            print(f"stats de '{proj['name']}' falló: [{st}] {_err(res)}",
                  file=sys.stderr)
            return 1
        if args.json:
            _json_out({"project": proj["name"], "project_id": proj["project_id"],
                       "stats": res})
            return 0
        print(f"estadísticas de {proj['name']} ({proj['project_id'][:8]}):")
        if isinstance(res, dict):
            for k in sorted(res):
                print(f"  {k:<16} {res[k]}")
        else:
            print(f"  {res}")
        return 0

    if act == "file":
        if not args.target:
            raise SystemExit("file exige la acción (get|put)")
        if not args.path:
            raise SystemExit("file exige la ruta dentro del proyecto")
        proj = c.resolve_project(args.project)
        pid = proj["project_id"]
        if args.target == "get":
            data = _core_call(c.project_file_read, pid, args.path)
            if isinstance(data, dict) and data.get("error"):
                print(f"no puedo leer '{args.path}': {data['error']}", file=sys.stderr)
                return 1
            if args.json:
                _json_out({"project": proj["name"], "path": args.path, "content": data})
            else:
                print(data)
            return 0
        if args.target == "put":
            if args.content is None:
                raise SystemExit("file put exige --content TEXTO")
            st, res = _core_call(c.project_file_write, pid, args.path, args.content)
            if not _ok(st) and st != 200:
                print(f"no puedo escribir '{args.path}': [{st}] {_err(res)}",
                      file=sys.stderr)
                return 1
            leido = _core_call(c.project_file_read, pid, args.path)
            print(f"escrito '{args.path}' ({len(args.content)} bytes) "
                  f"{'verificado' if leido == args.content else 'NO verificado'}")
            return 0 if leido == args.content else 1
        raise SystemExit(f"acción de fichero desconocida: {args.target}")

    raise SystemExit(f"acción desconocida: {act}")


