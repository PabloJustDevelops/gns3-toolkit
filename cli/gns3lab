def _cmd_compute_action(s: Server, c, args, act: str) -> int:
    """Administración de computes: add, update, rm, ports, idlepc y action."""
    if act == "add":
        body = _set_body(args.set)
        if not body:
            raise SystemExit("compute add exige --set clave=valor (repetible)")
        st, res = _core_call(c.compute_create, body)
        if not _ok(st):
            print(f"no se pudo crear el compute: [{st}] {_err(res)}", file=sys.stderr)
            return 1
        cid = res.get("compute_id") if isinstance(res, dict) else None
        # Releer: el 200 no prueba que el compute se haya registrado.
        checked = _core_call(c.compute, cid) if cid else None
        print(f"compute creado: {cid or '?'} "
              f"{'verificado' if isinstance(checked, dict) else 'sin verificación'}")
        return 0 if isinstance(checked, dict) else 1

    if act in ("update", "rm", "ports", "idlepc", "action") and not args.cid:
        raise SystemExit(f"compute {act} exige el compute_id o nombre")

    if act == "update":
        body = _set_body(args.set)
        if not body:
            raise SystemExit("compute update exige --set clave=valor (repetible)")
        st, res = _core_call(c.compute_update, args.cid, body)
        if not _ok(st):
            print(f"no se pudo editar el compute: [{st}] {_err(res)}", file=sys.stderr)
            return 1
        check = _core_call(c.compute, args.cid)
        malos = {k: {"pedido": v, "leído": check.get(k) if isinstance(check, dict) else None}
                 for k, v in body.items()
                 if not isinstance(check, dict) or check.get(k) != v}
        print(f"compute {args.cid}: " + ", ".join(f"{k}={v!r}" for k, v in body.items()))
        if malos:
            print(f"  la API no aplicó: {malos}", file=sys.stderr)
            return 1
        return 0

    if act == "rm":
        if not _confirm(args, f"borrar el compute {args.cid!r}"):
            return 1
        st, res = _core_call(c.compute_delete, args.cid)
        if not _ok(st):
            print(f"no se pudo borrar el compute: [{st}] {_err(res)}", file=sys.stderr)
            return 1
        quedan = [str(x.get("compute_id")) for x in _core_call(c.computes)]
        print(f"compute {args.cid} borrado"
              f"{' (sigue en la lista)' if args.cid in quedan else ''}")
        return 0

    if act == "ports":
        st, res = _core_call(c.compute_ports, args.cid)
        if st != 200:
            print(f"puertos de {args.cid} -> [{st}] {_err(res)}", file=sys.stderr)
            return 1
        if args.json:
            _json_out(res)
        else:
            _print_data(f"puertos de {args.cid}", res)
        return 0

    if act == "idlepc":
        st, res = _core_call(c.compute_auto_idlepc, args.cid)
        if not _ok(st) and st != 200:
            print(f"auto_idlepc de {args.cid} -> [{st}] {_err(res)}", file=sys.stderr)
            return 1
        if args.json:
            _json_out(res)
        else:
            print(f"auto_idlepc de {args.cid}: {res}")
        return 0

    # act == "action": ruta genérica /computes/{id}/{emulator}/{action}
    emulator = getattr(args, "emulator_arg", None) or args.emulator
    remote = getattr(args, "remote_arg", None) or args.remote_action
    if not emulator or not remote:
        raise SystemExit("compute action exige <emulador> <acción> "
                         "(o --emulator y --remote-action)")
    body = _set_body(args.set) or None
    st, res = _core_call(c.compute_action, args.cid, emulator, remote, body)
    if not _ok(st) and st != 200:
        print(f"compute {args.cid} {emulator}/{remote} -> "
              f"[{st}] {_err(res)}", file=sys.stderr)
        return 1
    if args.json:
        _json_out(res)
    else:
        _print_data(f"compute {args.cid} {emulator}/{remote}", res)
    return 0


def cmd_compute(args, conf):
    """Compute(s): lista, detalle y add|update|rm|ports|idlepc|action."""
    s = Server(args.server, conf)
    c = _core_client(s)
    act = getattr(args, "action", None)
    if act in COMPUTE_ACTIONS:
        return _cmd_compute_action(s, c, args, act)

    # Modo clásico: el primer posicional es el compute_id/nombre.
    needle_arg = act or getattr(args, "cid", None)
    comps = _core_call(c.computes)
    if not comps:
        print(f"GET /v2/computes no devolvió computes en {s.url}", file=sys.stderr)
        return 1
    if not needle_arg:
        filas = [_compute_row(x) for x in comps]
        if args.json:
            _json_out({"count": len(filas), "computes": filas})
            return 0
        for r in filas:
            estado = "conectado" if r["connected"] else "DESCONECTADO"
            print(f"  {str(r['compute_id']):<10} {str(r['name']):<24} {estado:<12} "
                  f"{r['protocol']}://{r['host']}:{r['port']}")
        return 0

    needle = needle_arg.lower()
    hits = [x for x in comps
            if str(x.get("compute_id", "")).lower() == needle
            or str(x.get("name", "")).lower() == needle]
    if not hits:
        raise SystemExit(f"compute no encontrado: {needle_arg!r}. Hay: "
                         + ", ".join(str(x.get("compute_id")) for x in comps))
    if len(hits) > 1:
        raise SystemExit(f"'{needle_arg}' es ambiguo: "
                         + ", ".join(str(x.get("compute_id")) for x in hits))
    cid = hits[0]["compute_id"]
    comp = _core_call(c.compute, cid)
    if not isinstance(comp, dict):
        print(f"GET /v2/computes/{cid} no devolvió datos", file=sys.stderr)
        return 1
    if args.json:
        _json_out(comp)
        return 0
    row = _compute_row(comp)
    caps = comp.get("capabilities") or {}
    print(f"  {row['name']} ({row['compute_id']}) "
          f"{'conectado' if row['connected'] else 'DESCONECTADO'}")
    print(f"    {row['protocol']}://{row['host']}:{row['port']} user={row['user']}")
    print(f"    plataforma={caps.get('platform')} versión={caps.get('version')} "
          f"cpu={row['cpu_usage_percent']}% mem={row['memory_usage_percent']}%")
    if row["last_error"]:
        print(f"    último error: {row['last_error']}")
    return 0


