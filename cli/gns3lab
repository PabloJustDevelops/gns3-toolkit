# consola: ejecutar, teclear y leer la pantalla sin VNC (núcleo gns3core)
# --------------------------------------------------------------------------- #
def _core_client(s: Server) -> "core.Client":
    return core.Client(s.url, s.auth, s.matcher, s.name)


def _core_project(s: Server, project: str | None):
    c = _core_client(s)
    proj = c.resolve_project(project)
    c.ensure_open(proj["project_id"])
    return c, proj


def _core_target(s: Server, project: str | None, node: str | None):
    c, proj = _core_project(s, project)
    if node is None:
        raise SystemExit("falta el nombre del nodo")
    obj = c.find_node(proj["project_id"], node)
    return c, proj, obj


def cmd_exec(args, conf):
    """Ejecuta comandos en la consola telnet: lectura por prompt, no por sleep."""
    s = Server(args.server, conf)
    c, proj, node = _core_target(s, args.project, args.node)
    if node.get("status") != "started":
        print(f"{node['name']} no está arrancado (status={node.get('status')})", file=sys.stderr)
        return 1
    try:
        con = core.console_for(c, proj["project_id"], node)
    except core.ConsoleError as e:
        print(str(e), file=sys.stderr)
        return 1
    try:
        ready = con.wait_ready(timeout=args.ready_timeout)
        print(f"{proj['name']} / {node['name']}  prompt={ready.get('prompt')!r} "
              f"ready={ready.get('ready')}", file=sys.stderr)
        fails = 0
        for r in con.run_many(args.commands, expect=args.expect, idle=args.idle,
                              timeout=args.timeout, answers=args.answers):
            print(f"$ {r['cmd']}")
            if r["output"]:
                print(r["output"])
            if r["timed_out"]:
                print(f"  [timeout tras {r['ms']} ms — la salida no se estabilizó]", file=sys.stderr)
                fails += 1
            print()
        return 1 if fails else 0
    finally:
        con.close()


def cmd_console(args, conf):
    """Consola única del nodo: interactiva por stdin o `--send` sin TTY.

    Es el atajo contra el VNC: una sola sesión telnet con prompt real, en vez de
    abrir y cerrar el socket en cada comando. `exit` (o Ctrl-D) sale sin mandar nada
    al nodo. En un nodo gráfico se remite a `shot`/`type`/`key`, igual que `exec`.

    Con `reset <nodo>` reinicia la consola del nodo; con `url <nodo>` muestra su
    WebSocket. Ambas acciones delegan en `gns3core`.
    """
    s = Server(args.server, conf)
    modo = args.node if args.node in ("reset", "url", "reset-all") else None
    if modo and not args.target and modo != "reset-all":
        raise SystemExit(f"console {modo} exige el nombre del nodo")
    if modo == "reset-all":
        if not _confirm(args, "reiniciar las consolas de todos los nodos del proyecto"):
            return 1
        c, proj = _core_project(s, args.project)
        st, res = _core_call(c.nodes_console_reset, proj["project_id"])
        if not _ok(st) and st != 200:
            print(f"reset de consolas de {proj['name']} -> "
                  f"[{st}] {_err_literal(res)}", file=sys.stderr)
            return 1
        print(f"{proj['name']}: consolas reiniciadas [{st}]")
        return 0
    node_name = args.target if modo else args.node
    c, proj, node = _core_target(s, args.project, node_name)
    pid = proj["project_id"]
    if modo == "reset":
        st, res = _core_call(c.console_reset, pid, node["node_id"])
        if not _ok(st):
            print(f"no se pudo reiniciar la consola de {node['name']}: "
                  f"[{st}] {_err(res)}", file=sys.stderr)
            return 1
        print(f"{node['name']}: consola reiniciada")
        return 0
    if modo == "url":
        print(_core_call(c.console_ws_url, pid, node["node_id"]))
        return 0
    if node.get("status") != "started":
        print(f"{node['name']} no está arrancado (status={node.get('status')})", file=sys.stderr)
        return 1
    try:
        con = core.console_for(c, proj["project_id"], node)
    except core.ConsoleError as e:
        print(str(e), file=sys.stderr)
        print("  consola gráfica: usa `gns3lab shot`, `gns3lab type` o `gns3lab key` "
              "(el VNC es el último recurso)", file=sys.stderr)
        return 1
    try:
        ready = con.wait_ready(timeout=args.ready_timeout)
        print(f"{proj['name']} / {node['name']}  prompt={ready.get('prompt')!r} "
              f"ready={ready.get('ready')}", file=sys.stderr)
        if args.send:
            fails = 0
            for cmd in args.send:
                r = con.run(cmd, expect=args.expect, idle=args.idle, timeout=args.timeout)
                if r["output"]:
                    print(r["output"])
                if r["timed_out"]:
                    print(f"  [timeout tras {r['ms']} ms — la salida no se estabilizó]",
                          file=sys.stderr)
                    fails += 1
            return 1 if fails else 0

        if sys.stdin.isatty():
            print("escribe comandos; `exit` para salir", file=sys.stderr)
        while True:
            sys.stderr.write(f"{node['name']}> ")
            sys.stderr.flush()
            linea = sys.stdin.readline()
            if not linea:                    # EOF: tubería cerrada o Ctrl-D
                sys.stderr.write("\n")
                break
            linea = linea.rstrip("\r\n")
            if linea.strip().lower() in ("exit", "quit", "salir"):
                break
            if not linea.strip():
                continue
            try:
                r = con.run(linea, expect=args.expect, idle=args.idle, timeout=args.timeout)
            except core.ConsoleError as e:
                print(f"consola cerrada: {e}", file=sys.stderr)
                return 1
            if r["output"]:
                print(r["output"])
            if r["timed_out"]:
                print(f"  [timeout tras {r['ms']} ms]", file=sys.stderr)
        return 0
    except KeyboardInterrupt:
        print("\nsalgo", file=sys.stderr)
        return 130
    finally:
        con.close()


def _monitor(s: Server, project, node_name) -> "core.QemuMonitor":
    c, proj, node = _core_target(s, project, node_name)
    if node.get("node_type") != "qemu":
        raise SystemExit(f"{node['name']} no es QEMU ({node.get('node_type')}); usa `gns3lab exec`")
    disk = (node.get("properties") or {}).get("hda_disk_image")
    try:
        return core.QemuMonitor.for_node(node_id=node["node_id"], disk=disk)
    except RuntimeError as e:
        raise SystemExit(str(e))


def cmd_shot(args, conf):
    """Captura el framebuffer del nodo y lo pasa por OCR: leer sin VNC."""
    s = Server(args.server, conf)
    mon = _monitor(s, args.project, args.node)
    try:
        shot = core.screen_text(mon, psm=args.psm, scale=args.scale)
    finally:
        mon.close()
    if shot.get("error"):
        print(shot, file=sys.stderr)
        return 1
    print(f"{shot['path']}  ({shot.get('bytes', 0)//1024} KB)")
    if not args.no_ocr and shot.get("ocr"):
        print()
        print(shot["ocr"])
    return 0


def cmd_key(args, conf):
    """Pulsa teclas por el monitor HMP (`ret`, `down`, `shift-2`, `f2`)."""
    s = Server(args.server, conf)
    mon = _monitor(s, args.project, args.node)
    try:
        mon.sendkey(*args.keys, delay=args.delay)
        if args.show:
            print(core.screen_text(mon).get("ocr", ""))
    finally:
        mon.close()
    return 0


def cmd_type(args, conf):
    """Escribe un texto en el nodo traduciéndolo a sendkey (menús, login)."""
    s = Server(args.server, conf)
    mon = _monitor(s, args.project, args.node)
    try:
        res = mon.type_text(args.text, delay=args.delay)
        if res["unknown"]:
            print(f"aviso: sin traducción a tecla: {res['unknown']}", file=sys.stderr)
        if args.enter:
            mon.sendkey("ret")
        if not args.no_show:
            print(core.screen_text(mon, psm=args.psm).get("ocr", ""))
    finally:
        mon.close()
    return 0


def cmd_mon(args, conf):
    """Comando HMP crudo sobre el nodo QEMU (info status, system_reset...)."""
    s = Server(args.server, conf)
    mon = _monitor(s, args.project, args.node)
    try:
        print(json.dumps(mon.run(" ".join(args.cmd)), ensure_ascii=False, indent=2))
    finally:
        mon.close()
    return 0


def cmd_new(args, conf):
    """Crea un proyecto vacío y lo abre (esqueleto para el examen)."""
    s = Server(args.server, conf)
    c = _core_client(s)
    path = str(Path.home() / "GNS3/projects" / args.name)
    st, body = c.post("/v2/projects", {"name": args.name, "path": path})
    if st not in (200, 201):
        print(f"no se pudo crear: [{st}] {body}", file=sys.stderr)
        return 1
    pid = body.get("project_id")
    st2, _ = c.post(f"/v2/projects/{pid}/open", timeout=180)
    print(f"{args.name} creado ({pid[:8]}), abierto={st2 in (200, 201)}")
    return 0


def _err(body) -> str:
    """Mensaje corto de error de la API (evita el volcado de schema anidado)."""
    msg = body.get("message") if isinstance(body, dict) else str(body)
    if isinstance(msg, str) and "JSON schema error" in msg:
        inner = msg[msg.find("{"):]
        m = re.search(r'"message"\s*:\s*"([^"]+)"', inner)
        if m:
            return m.group(1)[:300]
    return str(msg)[:400]


def _err_literal(body) -> str:
    """Errores del compute: un 500 con traceback se muestra completo, sin recortar."""
    if isinstance(body, str) and ("Traceback" in body or "\n" in body):
        return body
    return _err(body)


def cmd_node(args, conf):
    """Nodos: add (plantilla), rm, dup, props, switch (VLANs), disk (clonar qcow2)."""
    s = Server(args.server, conf)
    c = _core_client(s)
    proj = c.resolve_project(args.project)
    pid = proj["project_id"]
    c.ensure_open(pid)
    act = args.action

    if act == "disk-resize":
        if not args.node:
            raise SystemExit("disk-resize exige el nombre del nodo")
        if args.size is None:
            raise SystemExit("disk-resize exige --size (GB)")
        if args.size <= 0:
            raise SystemExit("disk-resize exige --size mayor que 0 (GB)")
        node = c.find_node(pid, args.node)
        # la CLI habla GB; la API de GNS3 2.2 recibe MiB en `extend`.
        mib = int(round(args.size * 1024))
        st, body = _core_call(c.node_resize_disk, pid, node["node_id"], mib)
        ok = _ok(st)
        print(f"{node['name']}: resize a {args.size:g} GB ({mib} MiB) "
              f"-> {'OK' if ok else _err(body)}")
        return 0 if ok else 1

    if act in ("links", "idlepc"):
        if not args.node:
            raise SystemExit(f"{act} exige el nombre del nodo")
        node = c.find_node(pid, args.node)
        if act == "links":
            enlaces = _core_call(c.node_links, pid, node["node_id"])
            if args.json:
                _json_out({"node": node["name"], "count": len(enlaces), "links": enlaces})
                return 0
            nombres = {n["node_id"]: n["name"] for n in c.nodes(pid)}
            print(f"enlaces de {node['name']}: {len(enlaces)}")
            for l in enlaces:
                extremos = " <-> ".join(
                    f"{nombres.get(e['node_id'], '?')}:{e['adapter_number']}/{e['port_number']}"
                    for e in l.get("nodes", []))
                print(f"  {str(l.get('link_id'))[:8]}  {l.get('link_type') or '-':<10} "
                      f"{extremos}")
            return 0
        st, res = _core_call(c.node_idlepc, pid, node["node_id"], args.proposals)
        if st != 200 and not _ok(st):
            print(f"idlepc de {node['name']} -> [{st}] {_err(res)}", file=sys.stderr)
            return 1
        if args.json:
            _json_out(res)
        else:
            _print_data(f"idlepc de {node['name']}"
                        + (" (propuestas)" if args.proposals else ""), res)
        return 0

    if act == "add":
        if not args.template:
            raise SystemExit("add exige --template")
        tpl = next((t for t in c.templates()
                    if t.get("template_id") == args.template
                    or str(t.get("name", "")).lower() == args.template.lower()), None)
        if not tpl:
            raise SystemExit(f"plantilla no encontrada: {args.template}")
        st, body = c.post(f"/v2/projects/{pid}/templates/{tpl['template_id']}",
                          {"x": args.x, "y": args.y, "compute_id": "local"})
        if st not in (200, 201):
            msg = _err(body)
            print(f"no se pudo añadir: [{st}] {msg}", file=sys.stderr)
            if "NAT interface" in msg or "libvirt" in msg:
                print("  → el nodo NAT usa una red libvirt (gns3-nat*): "
                      "`sudo systemctl start libvirtd` y reintenta", file=sys.stderr)
            return 1
        nid = body["node_id"]
        if args.name:
            c.put(f"/v2/projects/{pid}/nodes/{nid}", {"name": args.name})
        print(f"{args.name or body['name']} ({nid[:8]}) tipo={body.get('node_type')}")
        return 0

    if not args.node:
        raise SystemExit(f"{act} exige el nombre del nodo")
    node = c.find_node(pid, args.node)
    nid = node["node_id"]

    if act in ("start", "stop", "reload", "suspend", "resume", "pause", "unpause"):
        # `pause` de Docker deja el nodo en `suspended` (qemu no ofrece pause);
        # `resume`/`unpause` vuelven a `started`.
        want = {"start": "started", "stop": "stopped", "reload": "started",
                "suspend": "suspended", "resume": "started",
                "pause": "suspended", "unpause": "started"}[act]
        st, body = c.node_action(pid, nid, act)
        if st not in (200, 201, 204):
            print(f"{node['name']} {act} falló: [{st}] {_err(body)}", file=sys.stderr)
            return 1
        estado = _wait_node_status(c, pid, nid, want, timeout=args.wait)
        ok = estado == want
        print(f"{node['name']}: {act} -> status={estado}"
              + ("" if ok else f" (no llegó a {want} en {args.wait:.0f} s)"))
        return 0 if ok else 1

    if act == "line":
        cmdline = c.node_command_line(pid, nid)
        if not cmdline:
            print(f"{node['name']}: la API no devuelve command_line", file=sys.stderr)
            return 1
        print(cmdline)
        return 0

    if act == "rm":
        st, _ = c.delete(f"/v2/projects/{pid}/nodes/{nid}", timeout=120)
        print(f"{node['name']} borrado={st in (200, 204)}")
        return 0 if st in (200, 204) else 1

    if act == "dup":
        st, body = c.post(f"/v2/projects/{pid}/nodes/{nid}/duplicate",
                          {"x": args.x, "y": args.y, "name": args.name}, timeout=180)
        if st not in (200, 201):
            print(f"duplicate falló: [{st}] {body}", file=sys.stderr)
            return 1
        print(f"duplicado como {body.get('name')} ({body['node_id'][:8]})")
        return 0

    if act == "props":
        if not args.set:
            raise SystemExit("props exige --set clave=valor (repetible)")
        # `console`, `name`, `x`, `y`... son campos del nodo, no de properties:
        # dentro de properties se aceptan y no cambian nada (200 mentiroso).
        TOP = {"name", "console", "console_type", "x", "y", "z", "symbol", "locked"}
        props: dict = {}
        top: dict = {}
        for kv in args.set:
            if "=" not in kv:
                raise SystemExit(f"--set espera clave=valor, no {kv}")
            k, v = kv.split("=", 1)
            (top if k in TOP else props)[k] = _kv_value(v)
        body: dict = {}
        if props:
            body["properties"] = props
        body.update(top)
        st, body_res = c.put(f"/v2/projects/{pid}/nodes/{nid}", body, timeout=120)
        ok = st in (200, 201)
        print(f"{node['name']}: {body} -> {'OK' if ok else _err(body_res)}")
        return 0 if ok else 1

    if act == "switch":
        """VLANs del switch: `--port 1=access:20 --port 0=dot1q:43`."""
        cur = (node.get("properties") or {}).get("ports_mapping") or []
        mapping = [dict(p) for p in cur]
        for spec in args.port:
            if "=" not in spec:
                raise SystemExit(f"--port espera N=tipo[:vlan], no {spec}")
            idx, val = spec.split("=", 1)
            kind, _, vlan = val.partition(":")
            idx = int(idx)
            while len(mapping) <= idx:
                n = len(mapping)
                mapping.append({"name": f"Ethernet{n}", "port_number": n,
                                "type": "access", "vlan": 1, "ethertype": ""})
            mapping[idx] = {"name": mapping[idx].get("name", f"Ethernet{idx}"),
                            "port_number": idx,
                            "type": kind, "vlan": int(vlan) if vlan else 1,
                            "ethertype": ""}
        st, body = c.put(f"/v2/projects/{pid}/nodes/{nid}",
                         {"properties": {"ports_mapping": mapping}}, timeout=120)
        ok = st in (200, 201)
        print(f"{node['name']}: {len(mapping)} puertos -> {'OK' if ok else _err(body)}")
        return 0 if ok else 1

    if act == "disk":
        src_name = args.from_disk or (node.get("properties") or {}).get("hda_disk_image")
        if not src_name:
            raise SystemExit("disk exige --from o un nodo con hda_disk_image")
        images = Path.home() / "GNS3/images/QEMU"
        src = images / os.path.basename(src_name)
        if not src.exists():
            raise SystemExit(f"no existe {src}")
        dst_name = args.name or f"{src.stem}-{time.strftime('%H%M%S')}.qcow2"
        dst = images / dst_name
        if dst.exists():
            raise SystemExit(f"ya existe {dst}")
        qemu_img = shutil.which("qemu-img")
        print(f"clonando {src.name} ({src.stat().st_size/2**20:.0f} MB) -> {dst_name}")
        if qemu_img:
            r = subprocess.run([qemu_img, "convert", "-O", "qcow2", str(src), str(dst)],
                               capture_output=True, text=True)
            if r.returncode != 0:
                raise SystemExit(f"qemu-img falló: {r.stderr.strip()}")
        else:
            shutil.copy2(src, dst)
        st, body = c.put(f"/v2/projects/{pid}/nodes/{nid}",
                         {"properties": {"hda_disk_image": dst_name,
                                         "hda_disk_image_md5sum": "",
                                         "linked_clone": False}}, timeout=120)
        print(f"{dst_name} ({dst.stat().st_size/2**20:.0f} MB) enlazado={st in (200, 201)}")
        return 0 if st in (200, 201) else 1

    raise SystemExit(f"acción desconocida: {act}")


def cmd_upload(args, conf):
    """Sube un qcow2/iso al servidor (comprimido si es qcow2)."""
    s = Server(args.server, conf)
    c = _core_client(s)
    src = Path(args.file).expanduser()
    if not src.is_file():
        raise SystemExit(f"no existe {src}")
    name = args.name or src.name
    payload, tmp = src, None
    if args.compress and src.suffix.lower() == ".qcow2" and shutil.which("qemu-img"):
        fd, tmp_name = tempfile.mkstemp(prefix="upload-", suffix=".qcow2")
        os.close(fd)                        # qemu-img trabaja sobre la ruta, no el descriptor
        tmp = Path(tmp_name)
        print(f"comprimiendo {src.name} ({src.stat().st_size/2**20:.0f} MB)")
        r = subprocess.run(["qemu-img", "convert", "-c", "-O", "qcow2", str(src), str(tmp)],
                           capture_output=True, text=True)
        if r.returncode == 0:
            payload = tmp
            print(f"  -> {tmp.stat().st_size/2**20:.0f} MB")
    try:
        data = payload.read_bytes()
        print(f"subiendo {name} ({len(data)/2**20:.0f} MB)")
        st, body = c.compute_write_file("local", "qemu", name, data)
    finally:
        if tmp:
            tmp.unlink(missing_ok=True)
    if st not in (200, 201, 204):
        print(f"subida falló: [{st}] {body}", file=sys.stderr)
        return 1
    listed = [i.get("filename") for i in c.qemu_images()]
    print(f"OK: {name} {'verificado' if name in listed else 'NO aparece en la lista'}"
          f" ({len(listed)} imágenes en el servidor)")
    return 0 if name in listed else 1


def _draw_text(svg: str) -> str:
    """Texto visible de una nota SVG, para listarla sin volcar el SVG entero."""
    trozos = re.findall(r"<text[^>]*>(.*?)</text>", svg or "", re.S)
    return " | ".join(re.sub(r"<[^>]+>", "", t).strip() for t in trozos if t.strip())


DRAW_FIELDS = {"x", "y", "z", "rotation", "locked", "svg"}


def cmd_draw(args, conf):
    """Notas del canvas: crear con texto, list, edit <id> --set k=v y rm <id>."""
    s = Server(args.server, conf)
    c = _core_client(s)
    proj = c.resolve_project(args.project)
    pid = proj["project_id"]
    c.ensure_open(pid)
    palabras = args.text
    act = palabras[0].lower() if palabras else "list"

    if act in ("list", "ls"):
        notas = c.drawings(pid)
        if not notas:
            print("  sin notas")
            return 0
        for d in notas:
            texto = _draw_text(d.get("svg", "")) or "(sin texto)"
            print(f"  {str(d.get('drawing_id'))[:8]}  x={d.get('x')} y={d.get('y')}  "
                  f"{texto[:72]}")
        return 0

    if act in ("edit", "rm"):
        if len(palabras) < 2:
            raise SystemExit(f"{act} exige el drawing_id "
                             "(míralos con `gns3lab draw list`)")
        nota = _resolve_id(c.drawings(pid), palabras[1], "drawing_id", "nota")
        did = nota["drawing_id"]
        if act == "rm":
            st, res = c.drawing_delete(pid, did)
            if st not in (200, 204):
                print(f"no se pudo borrar la nota {did[:8]}: [{st}] {_err(res)}",
                      file=sys.stderr)
                return 1
            print(f"nota {did[:8]} borrada; quedan {len(c.drawings(pid))}")
            return 0
        body = _set_body(args.set)
        if not body:
            raise SystemExit("edit exige --set clave=valor (repetible)")
        raros = sorted(set(body) - DRAW_FIELDS)
        if raros:
            raise SystemExit(f"campos no editables en una nota: {', '.join(raros)}. "
                             f"Válidos: {', '.join(sorted(DRAW_FIELDS))}")
        st, res = c.drawing_update(pid, did, body)
        if st not in (200, 201):
            print(f"no se pudo editar la nota {did[:8]}: [{st}] {_err(res)}",
                  file=sys.stderr)
            return 1
        # Releer: un 200 del PUT no prueba que el campo haya cambiado.
        st, check = c.get(f"/v2/projects/{pid}/drawings/{did}")
        if st != 200 or not isinstance(check, dict):
            print(f"editada {did[:8]}, pero no puedo releerla: [{st}] {_err(check)}",
                  file=sys.stderr)
            return 1
        print(f"nota {did[:8]}: " + ", ".join(f"{k}={check.get(k)!r}" for k in body))
        malos = {k: {"pedido": v, "leído": check.get(k)}
