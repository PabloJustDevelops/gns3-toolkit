def _set_body(kvs: list[str]) -> dict:
    """Convierte `--set clave=valor` repetidos en un dict (valores JSON si se puede)."""
    body: dict = {}
    for kv in kvs or []:
        if "=" not in kv:
            raise SystemExit(f"--set espera clave=valor, no {kv}")
        k, v = kv.split("=", 1)
        body[k] = _kv_value(v)
    return body


def _resolve_id(items: list[dict], needle: str, key: str, what: str) -> dict:
    """Busca un objeto por id exacto, nombre exacto, prefijo de id o error."""
    exact = [x for x in items if str(x.get(key, "")) == needle]
    if exact:
        return exact[0]
    named = [x for x in items if str(x.get("name", "")).lower() == needle.lower()]
    if len(named) == 1:
        return named[0]
    pref = [x for x in items if str(x.get(key, "")).startswith(needle)]
    if len(pref) == 1:
        return pref[0]
    hits = named or pref
    if not hits:
        raise SystemExit(f"{what} no encontrado: {needle!r}")
    raise SystemExit(f"'{needle}' es ambiguo: "
                     + ", ".join(f"{x.get('name') or str(x.get(key))[:8]}"
                                 for x in hits))


