def _notify_snapshot(c, pid: str | None, count: int) -> list:
    """Ventana de `count` eventos del stream de notificaciones.

    `Client.notifications()` hace `GET /v2/notifications`, que es un stream
    chunked que nunca termina: leerlo entero cuelga la CLI. Se abre la misma
    ruta con las credenciales del núcleo y se corta tras `count` líneas.
    """
    path = f"/v2/projects/{pid}/notifications" if pid else "/v2/notifications"
    headers = {}
    if c.auth:
        tok = base64.b64encode(f"{c.auth[0]}:{c.auth[1]}".encode()).decode()
        headers["Authorization"] = "Basic " + tok
    req = urllib.request.Request(c.url + path, headers=headers, method="GET")
    eventos: list = []
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            for _ in range(count):
                linea = r.readline()
                if not linea:
                    break
                try:
                    eventos.append(json.loads(linea.decode()))
                except (json.JSONDecodeError, UnicodeDecodeError):
                    eventos.append(linea.decode(errors="replace"))
    except (ConnectionError, TimeoutError, OSError) as e:
        raise SystemExit(f"fallo de conexión con el servidor: {e}")
    return eventos


